/* 使用指南列表页样式 */

.guide-list {
  padding: 48rpx 32rpx;
}

.guide-item {
  padding: 32rpx 0;
  position: relative;
}

.guide-item::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: var(--md-outline-variant);
}

.guide-item:last-child::after {
  display: none;
}

.guide-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.guide-date {
  font-size: 22rpx;
  color: var(--md-on-surface-variant);
}

.guide-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--md-on-surface);
  line-height: 1.4;
  display: block;
}
