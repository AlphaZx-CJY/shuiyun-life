<md-app-bar title="使用指南" showBack="{{true}}" />

<view class="page-container">
  <view class="guide-list" wx:if="{{guideList.length > 0}}">
    <view class="guide-item" wx:for="{{guideList}}" wx:key="id" data-id="{{item.id}}" bindtap="onGuideTap">
      <view class="guide-header">
        <text class="md-tag md-tag--primary">{{item.tag}}</text>
        <text class="guide-date">{{item.date}}</text>
      </view>
      <text class="guide-title">{{item.title}}</text>
    </view>
  </view>

  <md-empty-state wx:if="{{guideList.length === 0}}" headline="暂无使用指南" />
</view>
