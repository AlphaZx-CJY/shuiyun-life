<md-app-bar title="使用指南" showBack="{{true}}" />

<view class="page-container page-container--with-tabbar">
  <!-- Guide List -->
  <view class="guide-list" wx:if="{{guideList.length > 0}}">
    <view class="guide-card" wx:for="{{guideList}}" wx:key="id" data-id="{{item.id}}" bindtap="onGuideTap">
      <view class="guide-icon-box">
        <md-icon name="/images/icons/material/menu_book-on.svg" size="48" color="currentColor" />
      </view>
      <view class="guide-content">
        <view class="guide-header">
          <text class="guide-tag">{{item.tag}}</text>
          <text class="guide-date">{{item.date}}</text>
        </view>
        <text class="guide-title">{{item.title}}</text>
      </view>
    </view>
  </view>

  <!-- Empty State -->
  <md-empty-state
    wx:if="{{guideList.length === 0 && !loading}}"
    icon="/images/icons/material/menu_book-on.svg"
    headline="暂无指南"
    supportingText="暂时没有使用指南"
  />
</view>
