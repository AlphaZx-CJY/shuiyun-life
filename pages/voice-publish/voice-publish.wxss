/* 发布诉求 — Material 3 表单风格 */ .form-body { padding: 32rpx 40rpx; } .form-item { margin-bottom: 32rpx; }
.form-item:last-child { margin-bottom: 0; } .form-item-header { display: flex; align-items: center; gap: 12rpx;
margin-bottom: 16rpx; } .form-item-header md-icon { flex-shrink: 0; } .form-label { font-size: 28rpx; font-weight: 500;
color: var(--md-on-surface); } /* picker */ .form-picker { display: flex; align-items: center; justify-content:
space-between; height: 96rpx; padding: 0 32rpx; background: var(--md-surface-container-low); border-radius: 16rpx;
border: 1rpx solid var(--md-outline-variant); } .form-picker-text { font-size: 30rpx; color: var(--md-on-surface); }
.form-picker-placeholder { color: var(--md-on-surface-variant); } .picker-arrow { width: 16rpx; height: 16rpx;
border-top: 3rpx solid var(--md-outline); border-right: 3rpx solid var(--md-outline); transform: rotate(45deg); } /*
counter */ .form-counter { text-align: right; font-size: 22rpx; color: var(--md-on-surface-variant); margin-top: 8rpx;
display: block; } /* 图片上传 */ .image-upload-row { display: flex; flex-wrap: wrap; gap: 20rpx; } .image-thumb-wrap {
position: relative; width: 200rpx; height: 200rpx; } .image-thumb { width: 200rpx; height: 200rpx; border-radius: 20rpx;
background: var(--md-surface-container); } .image-remove { position: absolute; top: -12rpx; right: -12rpx; width: 44rpx;
height: 44rpx; background: var(--md-error); border-radius: 50%; display: flex; align-items: center; justify-content:
center; } .image-remove-icon { color: var(--md-on-error); font-size: 28rpx; line-height: 1; } .image-upload-btn { width:
200rpx; height: 200rpx; border-radius: 20rpx; border: 2rpx dashed var(--md-outline-variant); background:
var(--md-surface-container-low); display: flex; align-items: center; justify-content: center; } .image-upload-plus {
font-size: 48rpx; color: var(--md-outline); font-weight: 300; } /* 提交按钮 */ .form-actions { margin: 0 40rpx 48rpx; }
.btn-pill { width: 100%; height: 96rpx; border-radius: 9999rpx; display: flex; align-items: center; justify-content:
center; font-size: 32rpx; font-weight: 600; transition: opacity 100ms ease; } .btn-pill:active { opacity: 0.85; }
.btn-pill--primary { background: var(--md-primary); color: var(--md-on-primary); } .btn-pill--disabled { opacity: 0.5;
pointer-events: none; }
