<md-app-bar title="发布诉求" showBack="{{true}}" />

<view class="page-container">
  <view class="form-body">
    <!-- 诉求类型 -->
    <view class="form-item">
      <view class="form-item-header">
        <md-icon name="/images/icons/material/article-on.svg" size="28" color="currentColor" />
        <text class="form-label">诉求类型 *</text>
      </view>
      <md-text-field label="" placeholder="如：求购、顺风车、求代购..." value="{{type}}" bind:input="onTypeInput" />
    </view>

    <!-- 诉求内容 -->
    <view class="form-item">
      <view class="form-item-header">
        <md-icon name="/images/icons/material/article-on.svg" size="28" color="currentColor" />
        <text class="form-label">诉求内容 *</text>
      </view>
      <md-text-field
        label=""
        placeholder="请详细描述您的诉求，如物品规格、出发时间、目的地等..."
        value="{{content}}"
        maxlength="500"
        multiline
        bind:input="onContentInput"
      />
      <text class="form-counter">{{content.length}}/500</text>
    </view>

    <!-- 截止日期 -->
    <view class="form-item">
      <view class="form-item-header">
        <md-icon name="/images/icons/material/event-on.svg" size="28" color="currentColor" />
        <text class="form-label">截止日期 *</text>
      </view>
      <picker mode="date" value="{{deadline}}" bindchange="onDeadlineChange">
        <view class="form-picker">
          <text class="form-picker-text {{deadline ? '' : 'form-picker-placeholder'}}"
            >{{deadline || '请选择截止日期'}}</text
          >
          <view class="picker-arrow"></view>
        </view>
      </picker>
    </view>

    <!-- 联系方式 -->
    <view class="form-item">
      <view class="form-item-header">
        <md-icon name="/images/icons/material/call-on.svg" size="28" color="currentColor" />
        <text class="form-label">联系方式（选填）</text>
      </view>
      <md-text-field
        label=""
        placeholder="手机号或微信号，方便他人联系您"
        value="{{contact}}"
        bind:input="onContactInput"
      />
    </view>

    <!-- 上传图片 -->
    <view class="form-item">
      <view class="form-item-header">
        <md-icon name="/images/icons/material/article-on.svg" size="28" color="currentColor" />
        <text class="form-label">上传图片 <text class="form-optional">（最多6张）</text></text>
      </view>
      <view class="image-upload-row">
        <view class="image-thumb-wrap" wx:for="{{images}}" wx:key="*this">
          <image class="image-thumb" src="{{item}}" mode="aspectFill" bindtap="onPreviewImage" data-index="{{index}}" />
          <view class="image-remove" data-index="{{index}}" bindtap="onRemoveImage">
            <text class="image-remove-icon">×</text>
          </view>
        </view>
        <view wx:if="{{images.length < 6}}" class="image-upload-btn" bindtap="onChooseImage">
          <text class="image-upload-plus">+</text>
        </view>
      </view>
    </view>
  </view>

  <view class="form-actions">
    <view class="btn-pill btn-pill--primary {{submitting ? 'btn-pill--disabled' : ''}}" bindtap="onSubmit">
      {{submitting ? '发布中...' : '发布诉求'}}
    </view>
  </view>
</view>
