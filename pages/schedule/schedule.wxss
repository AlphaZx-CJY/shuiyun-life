/* 活动安排页样式 */

.schedule-sections {
  padding: 32rpx 32rpx 48rpx;
}

.schedule-section {
  margin-bottom: 48rpx;
}

.schedule-section-title {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--md-on-surface-variant);
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  line-height: 1.33;
  display: block;
}

.schedule-list {
  background: var(--md-surface-container-low);
  border-radius: 20rpx;
  overflow: hidden;
}

.schedule-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  position: relative;
}

.schedule-item::after {
  content: '';
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 0;
  height: 1rpx;
  background: var(--md-outline-variant);
  transform: scaleY(0.5);
}

.schedule-item:last-child::after {
  display: none;
}

.schedule-item--ended {
  opacity: 0.55;
}

.schedule-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 100rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.schedule-date-label {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--md-primary);
  line-height: 1.3;
}

.schedule-time-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--md-on-surface);
  line-height: 1.3;
  margin-top: 4rpx;
}

.schedule-content {
  flex: 1;
  min-width: 0;
}

.schedule-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--md-on-surface);
  display: block;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.schedule-location {
  font-size: 24rpx;
  color: var(--md-on-surface-variant);
  display: block;
}

.schedule-status {
  font-size: 22rpx;
  font-weight: 500;
  padding: 6rpx 14rpx;
  border-radius: 9999rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.schedule-status--upcoming {
  background: var(--md-primary-container);
  color: var(--md-on-primary-container);
}

.schedule-status--ended {
  background: var(--md-surface-variant);
  color: var(--md-on-surface-variant);
}

.schedule-empty {
  margin-top: 64rpx;
}
