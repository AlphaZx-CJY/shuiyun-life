/* 活动安排页样式 */

.schedule-sections {
  padding: var(--space-2) var(--space-4) var(--space-6);
}

.schedule-section {
  margin-bottom: var(--space-6);
}

.schedule-section-title {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--md-on-surface-variant);
  margin-bottom: var(--space-2);
  padding-left: var(--space-2);
  line-height: 1.33;
  display: block;
}

.schedule-list {
  background: var(--md-surface);
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.schedule-item {
  display: flex;
  align-items: flex-start;
  padding: var(--space-3);
  position: relative;
}

.schedule-item::after {
  content: '';
  position: absolute;
  left: var(--space-3);
  right: var(--space-3);
  bottom: 0;
  height: 1rpx;
  background: var(--md-outline-variant);
  transform: scaleY(0.5);
}

.schedule-item:last-child::after {
  display: none;
}

.schedule-item--ended {
  opacity: 0.6;
}

.schedule-badge {
  padding: 6rpx 16rpx;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  font-weight: 500;
  margin-right: var(--space-2);
  margin-top: 4rpx;
  flex-shrink: 0;
}

.schedule-badge--upcoming {
  background: var(--md-primary-container);
  color: var(--md-on-primary-container);
}

.schedule-badge--ended {
  background: var(--md-surface-variant);
  color: var(--md-on-surface-variant);
}

.schedule-content {
  flex: 1;
  min-width: 0;
}

.schedule-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--md-on-surface);
  display: block;
  margin-bottom: 8rpx;
}

.schedule-info {
  font-size: 24rpx;
  color: var(--md-on-surface-variant);
  display: block;
  margin-bottom: 4rpx;
}

.schedule-location {
  font-size: 24rpx;
  color: var(--md-on-surface-variant);
  display: block;
}

.schedule-status {
  font-size: 22rpx;
  font-weight: 500;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-pill);
  flex-shrink: 0;
  margin-left: var(--space-2);
}

.schedule-status--upcoming {
  background: var(--md-primary-container);
  color: var(--md-on-primary-container);
}

.schedule-status--ended {
  background: var(--md-surface-variant);
  color: var(--md-on-surface-variant);
}

.schedule-empty {
  margin-top: var(--space-8);
}

