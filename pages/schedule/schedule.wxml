<view class="page-container page-container--with-tabbar">
  <view class="schedule-sections">
    <!-- 按类型分组的活动列表 -->
    <block wx:for="{{groups}}" wx:for-item="group" wx:key="type">
      <view class="schedule-section">
        <text class="schedule-section-title">{{group.type}}</text>
        <view class="schedule-list">
          <view
            class="schedule-item {{item.status === 'ended' ? 'schedule-item--ended' : ''}}"
            wx:for="{{group.list}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onScheduleTap"
          >
            <view class="schedule-left">
              <text class="schedule-date-label">{{item.date}}</text>
              <text class="schedule-time-label">{{item.time}}</text>
            </view>
            <view class="schedule-content">
              <text class="schedule-title">{{item.title}}</text>
              <text class="schedule-location">{{item.location}}</text>
            </view>
            <view class="schedule-status {{item.status === 'upcoming' ? 'schedule-status--upcoming' : 'schedule-status--ended'}}">
              {{item.status === 'upcoming' ? '即将开始' : '已结束'}}
            </view>
          </view>
        </view>
      </view>
    </block>

    <!-- 空状态 -->
    <view class="schedule-empty" wx:if="{{groups.length === 0}}">
      <md-empty-state icon="/images/icons/material/event-off.svg" headline="暂无活动安排" />
    </view>
  </view>
</view>
