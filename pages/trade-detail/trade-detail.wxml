<md-app-bar title="商品详情" showBack="{{true}}" />

<view class="page-container" wx:if="{{trade}}">
  <!-- 图片区域 -->
  <view class="detail-gallery">
    <image
      wx:if="{{trade.images.length}}"
      class="detail-main-image"
      src="{{trade.images[0]}}"
      mode="aspectFill"
      bindtap="onImageTap"
    />
    <view wx:else class="detail-main-image detail-main-image--placeholder">
      <image class="detail-placeholder-icon" src="/images/icons/material/storefront-on.svg" mode="aspectFit" />
    </view>
  </view>

  <!-- 信息卡片 -->
  <md-card shape="large">
    <view class="detail-info-card">
      <text class="detail-trade-title">{{trade.title}}</text>
      <view class="detail-price-row">
        <text class="detail-price">¥{{trade.price}}</text>
        <text class="detail-original" wx:if="{{trade.originalPrice}}">原价 ¥{{trade.originalPrice}}</text>
        <text class="discount-badge" wx:if="{{trade.discount}}">{{trade.discount}}% off</text>
      </view>
      <view class="detail-meta-row">
        <text class="detail-meta-text">{{trade.seller}}</text>
        <text class="detail-meta-text">{{trade.location}}</text>
        <text class="detail-meta-text">{{trade.time}}</text>
      </view>
    </view>
  </md-card>

  <!-- 商品描述 -->
  <view class="detail-desc-section">
    <text class="detail-section-title">商品描述</text>
    <text class="detail-desc-text">{{trade.description}}</text>
  </view>
</view>

<view class="page-container empty-fallback" wx:else>
  <md-empty-state
    icon="/images/icons/material/storefront-on.svg"
    headline="商品信息加载失败"
  />
</view>

<!-- 联系按钮 -->
<view class="detail-action-bar">
  <view class="detail-call-btn" bindtap="onCallTap">
    <text>联系卖家</text>
  </view>
</view>
