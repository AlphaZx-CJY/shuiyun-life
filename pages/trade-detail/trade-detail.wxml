<md-app-bar title="商品详情" showBack="{{true}}" />

<!-- 骨架图 -->
<view class="page-container" wx:if="{{loading}}">
  <view class="skeleton-gallery"></view>
  <view class="skeleton-info-block">
    <view class="skeleton-line skeleton-line--short"></view>
    <view class="skeleton-line skeleton-line--medium"></view>
    <view class="skeleton-line skeleton-line--long"></view>
  </view>
  <view class="skeleton-desc-block">
    <view class="skeleton-line skeleton-line--short"></view>
    <view class="skeleton-line skeleton-line--long"></view>
    <view class="skeleton-line skeleton-line--long"></view>
  </view>
</view>

<!-- 内容区域 -->
<view class="page-container" wx:elif="{{trade}}">
  <!-- 图片区域 -->
  <view class="detail-gallery">
    <swiper
      wx:if="{{trade.images.length > 0}}"
      class="detail-gallery-swiper"
      indicator-dots="{{trade.images.length > 1}}"
      circular
    >
      <swiper-item wx:for="{{trade.images}}" wx:key="*this">
        <image
          class="detail-main-image"
          src="{{item}}"
          mode="aspectFill"
          data-current="{{item}}"
          bindtap="onImageTap"
        />
      </swiper-item>
    </swiper>
    <view
      wx:else
      class="detail-main-image detail-main-image--placeholder {{trade.category === 'furniture' ? 'detail-color--primary' : trade.category === 'appliance' ? 'detail-color--tertiary' : trade.category === 'baby' ? 'detail-color--baby' : trade.category === 'books' ? 'detail-color--secondary' : 'detail-color--other'}}"
    >
      <md-icon
        name="/images/icons/material/{{trade.category === 'furniture' ? 'chair' : trade.category === 'appliance' ? 'tv' : trade.category === 'baby' ? 'child_care' : trade.category === 'books' ? 'book' : 'electric_bolt'}}.svg"
        size="80"
        color="currentColor"
      />
    </view>
  </view>

  <!-- 信息卡片 -->
  <view class="detail-info-card">
    <text class="detail-trade-title">{{trade.title}}</text>
    <view class="detail-price-row">
      <text class="detail-price">¥{{trade.price}}</text>
      <text class="detail-original" wx:if="{{trade.originalPrice}}">原价 ¥{{trade.originalPrice}}</text>
      <text class="discount-badge" wx:if="{{trade.discount}}">省{{trade.discount}}%</text>
    </view>
    <view class="detail-meta-row">
      <text class="detail-meta-text">{{trade.seller}}</text>
      <text class="detail-meta-text">{{trade.location}}</text>
      <text class="detail-meta-text">{{trade.time}}</text>
    </view>
  </view>

  <!-- 商品描述 -->
  <view class="detail-desc-section">
    <text class="detail-section-title">商品描述</text>
    <text class="detail-desc-text">{{trade.description}}</text>
  </view>

  <!-- 联系按钮 -->
  <view class="detail-action-bar">
    <view class="detail-call-btn" bindtap="onCallTap">
      <text>联系卖家</text>
    </view>
  </view>
</view>

<!-- 加载失败 -->
<view class="page-container empty-fallback" wx:else>
  <md-empty-state icon="/images/icons/material/storefront-on.svg" headline="商品信息加载失败" />
</view>
