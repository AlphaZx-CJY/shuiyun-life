/* 资讯详情页样式 */


.detail-header {
  padding: 48rpx 32rpx 32rpx;
}

.detail-tag {
  margin-bottom: 20rpx;
  display: inline-flex;
  padding: 8rpx 16rpx;
  background: var(--md-primary-container);
  color: var(--md-on-primary-container);
  border-radius: 4rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.detail-title {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--md-on-surface);
  line-height: 1.3;
  letter-spacing: -0.4rpx;
  display: block;
  margin-bottom: 20rpx;
}

.detail-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.detail-meta-dot {
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: var(--md-outline);
}

.detail-date,
.detail-views {
  font-size: 24rpx;
  color: var(--md-on-surface-variant);
}

.detail-content {
  padding: 32rpx;
  padding-bottom: 64rpx;
}

.detail-content rich-text {
  font-size: 32rpx;
  line-height: 1.75;
  color: var(--md-on-surface);
}

.empty-state {
  padding: 96rpx 32rpx;
  text-align: center;
}

.empty-state__text {
  font-size: 28rpx;
  color: var(--md-on-surface-variant);
}
