/* 缴费知识页样式 */

.payment-list {
  padding: 48rpx 32rpx;
}

.payment-item {
  padding: 32rpx 0;
  position: relative;
}

.payment-item::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: var(--md-outline-variant);
}

.payment-item:last-child::after {
  display: none;
}

.payment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.payment-tag-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.hot-badge {
  padding: 4rpx 12rpx;
  border-radius: var(--radius-pill);
  background: var(--md-primary);
  color: var(--md-on-primary);
  font-size: 20rpx;
  font-weight: 700;
}

.payment-date {
  font-size: 22rpx;
  color: var(--md-on-surface-variant);
}

.payment-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--md-on-surface);
  line-height: 1.4;
  display: block;
  margin-bottom: 8rpx;
}

.payment-summary {
  font-size: 26rpx;
  color: var(--md-on-surface-variant);
  line-height: 1.5;
  display: block;
}
