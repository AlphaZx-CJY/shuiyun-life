<md-app-bar title="社区心声" showBack="{{true}}" />

<view class="page-container">
  <!-- 固定头部：搜索栏 + 归档开关 -->
  <view class="fixed-header" style="top: {{appBarHeight}}px">
    <view class="search-bar">
      <md-icon name="/images/icons/material/search.svg" size="40" color="currentColor" />
      <input
        class="search-input"
        type="text"
        placeholder="搜索诉求类型或内容..."
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        adjust-position="{{false}}"
      />
      <view class="search-clear" wx:if="{{searchKeyword}}" bindtap="onSearchClear">
        <md-icon name="/images/icons/material/close.svg" size="24" color="currentColor" />
      </view>
    </view>

    <view class="archive-toggle" bindtap="onToggleArchived">
      <text class="archive-toggle-text">显示已过期的心声</text>
      <view class="archive-toggle-switch {{showArchived ? 'archive-toggle-switch--on' : ''}}">
        <view class="archive-toggle-knob"></view>
      </view>
    </view>
  </view>

  <!-- 可滚动内容区 -->
  <view class="scroll-wrap" style="top: {{scrollPaddingTop}}px">
    <scroll-view
      class="voice-scroll-wrap"
      enhanced
      scroll-y
      refresher-enabled="{{true}}"
      refresher-triggered="{{refreshing}}"
      bindrefresherrefresh="onPullDownRefresh"
    >
      <!-- Skeleton (initial load) -->
      <view class="voice-list" wx:if="{{loading && allVoiceList.length === 0}}">
        <view class="voice-card skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this">
          <view class="skeleton-icon"></view>
          <view class="skeleton-content">
            <view class="skeleton-line skeleton-line--short"></view>
            <view class="skeleton-line skeleton-line--long"></view>
            <view class="skeleton-line skeleton-line--medium"></view>
          </view>
        </view>
      </view>

      <!-- Voice List -->
      <view class="voice-list" wx:if="{{filteredVoiceList.length > 0}}">
        <view class="voice-card" wx:for="{{filteredVoiceList}}" wx:key="id" data-id="{{item.id}}" bindtap="onVoiceTap">
          <view class="voice-icon-box">
            <md-icon name="/images/icons/material/article-on.svg" size="56" color="currentColor" />
          </view>
          <view class="voice-content">
            <view class="voice-header">
              <text class="voice-tag">{{item.type}}</text>
              <text class="voice-date">{{item.createTime}}</text>
            </view>
            <text class="voice-title">{{item.content}}</text>
            <view class="voice-meta">
              <text class="voice-deadline">截止 {{item.deadline}}</text>
              <text wx:if="{{item.expired}}" class="voice-expired">已过期</text>
            </view>
          </view>
        </view>
      </view>

      <!-- Empty State -->
      <md-empty-state
        wx:if="{{filteredVoiceList.length === 0 && !loading}}"
        icon="/images/icons/material/article-off.svg"
        headline="{{searchKeyword ? '暂无匹配结果' : '暂无心声'}}"
        supportingText="{{searchKeyword ? '换个关键词试试' : '还没有人发布心声，快来发布第一条吧'}}"
      />
    </scroll-view>
  </view>

  <!-- Publish FAB -->
  <view class="fab-wrap">
    <view class="fab" bindtap="onPublishTap">
      <md-icon name="/images/icons/material/article-on.svg" size="32" color="currentColor" />
      <text class="fab-text">发布心声</text>
    </view>
  </view>
</view>
