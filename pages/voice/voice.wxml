<md-app-bar title="邻里互助" showBack="{{true}}" />

<view class="page-container">
  <!-- 诉求列表 -->
  <view class="voice-list" wx:if="{{voiceList.length > 0}}">
    <view class="voice-item {{item.expired ? 'voice-item--expired' : ''}}" wx:for="{{voiceList}}" wx:key="id" data-item="{{item}}" bindtap="onVoiceTap">
      <view class="voice-header">
        <md-chip variant="filled" active="{{true}}" class="voice-type-chip">{{item.type}}</md-chip>
        <text class="voice-status" wx:if="{{item.expired}}">已过期</text>
        <text class="voice-deadline" wx:else>截止 {{item.deadline}}</text>
      </view>
      <text class="voice-content">{{item.content}}</text>
      <view class="voice-meta">
        <text class="voice-date">{{item.createTime}}</text>
        <text class="voice-contact" wx:if="{{item.contact}}">{{item.contact}}</text>
      </view>
      <md-divider wx:if="{{index < voiceList.length - 1}}" />
    </view>
  </view>

  <!-- 空状态 -->
  <md-empty-state wx:if="{{voiceList.length === 0}}"
    icon="/images/icons/profile/help.svg"
    headline="暂无邻里互助信息"
    supporting-text="点击右下角按钮发布您的诉求" />

  <!-- 发布按钮 -->
  <view class="voice-fab" bindtap="onPublishTap">
    <text class="voice-fab-icon">+</text>
    <text class="voice-fab-text">发布</text>
  </view>
</view>
