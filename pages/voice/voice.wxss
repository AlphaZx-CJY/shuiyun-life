/* 社区心声页 */ .fixed-header { position: fixed; left: 0; right: 0; z-index: 10; background: var(--md-surface);
padding: 20rpx 0 28rpx; } .scroll-wrap { position: fixed; left: 0; right: 0; bottom: calc(120rpx +
env(safe-area-inset-bottom)); overflow: hidden; } .voice-scroll-wrap { height: 100%; } /* 搜索栏 */ .search-bar {
display: flex; align-items: center; gap: 16rpx; margin: 0 40rpx 16rpx; padding: 16rpx 24rpx; height: 80rpx; box-sizing:
border-box; background: var(--md-surface-container); border-radius: 16rpx; } .search-bar md-icon { color:
var(--md-on-surface-variant); flex-shrink: 0; } .search-input { flex: 1; font-size: 28rpx; color: var(--md-on-surface);
} .search-input::placeholder { color: var(--md-on-surface-variant); } .search-clear { width: 40rpx; height: 40rpx;
display: flex; align-items: center; justify-content: center; flex-shrink: 0; } .search-clear md-icon { color:
var(--md-on-surface-variant); } .voice-list { padding: 0 40rpx; } /* Skeleton */ @keyframes skeleton-pulse { 0%, 100% {
opacity: 1; } 50% { opacity: 0.55; } } .skeleton-card { background: var(--md-surface); } .skeleton-icon { width: 160rpx;
height: 160rpx; border-radius: 24rpx; background: var(--md-surface-container); flex-shrink: 0; animation: skeleton-pulse
1.6s ease-in-out infinite; } .skeleton-content { flex: 1; display: flex; flex-direction: column; gap: 20rpx;
justify-content: center; } .skeleton-line { height: 32rpx; border-radius: 8rpx; background: var(--md-surface-container);
animation: skeleton-pulse 1.6s ease-in-out infinite; } .skeleton-line--short { width: 40%; } .skeleton-line--long {
width: 90%; } .skeleton-line--medium { width: 60%; } .voice-card { display: flex; gap: 28rpx; background:
var(--md-surface); border-radius: 28rpx; padding: 28rpx; margin-bottom: 28rpx; transition: transform 100ms ease-out; }
.voice-card:active { transform: scale(0.98); } /* 归档开关 */ .archive-toggle { display: flex; align-items: center;
justify-content: space-between; margin: 0 40rpx 0; padding: 14rpx 28rpx; height: 80rpx; box-sizing: border-box;
background: var(--md-surface-container); border-radius: 16rpx; } .archive-toggle-text { font-size: 28rpx; font-weight:
500; color: var(--md-on-surface); } .archive-toggle-switch { width: 96rpx; height: 52rpx; border-radius: 9999rpx;
background: var(--md-outline-variant); position: relative; transition: background-color 200ms ease; }
.archive-toggle-switch--on { background: var(--md-primary); } .archive-toggle-knob { position: absolute; top: 4rpx;
left: 4rpx; width: 44rpx; height: 44rpx; border-radius: 50%; background: var(--md-on-primary); transition: transform
200ms ease; } .archive-toggle-switch--on .archive-toggle-knob { transform: translateX(44rpx); } /* 彩色图标方块 */
.voice-icon-box { width: 160rpx; height: 160rpx; border-radius: 24rpx; flex-shrink: 0; display: flex; align-items:
center; justify-content: center; position: relative; overflow: hidden; background: var(--md-voice-container); }
.voice-icon-box::after { content: ''; position: absolute; right: -30rpx; bottom: -30rpx; width: 80rpx; height: 80rpx;
border-radius: 50%; background: rgba(255, 255, 255, 0.25); } .voice-icon-box md-icon { color:
var(--md-voice-on-container); position: relative; z-index: 1; } /* 内容 */ .voice-content { flex: 1; display: flex;
flex-direction: column; justify-content: center; min-width: 0; } .voice-header { display: flex; align-items: center;
gap: 16rpx; margin-bottom: 12rpx; } .voice-tag { font-size: 22rpx; font-weight: 500; padding: 4rpx 16rpx; border-radius:
8rpx; background: var(--md-voice-container); color: var(--md-voice-on-container); } .voice-date { font-size: 24rpx;
color: var(--md-on-surface-variant); } .voice-title { font-size: 30rpx; font-weight: 600; color: var(--md-on-surface);
line-height: 1.4; margin-bottom: 12rpx; overflow: hidden; text-overflow: ellipsis; display: -webkit-box;
-webkit-line-clamp: 2; -webkit-box-orient: vertical; } .voice-meta { display: flex; align-items: center; gap: 16rpx; }
.voice-deadline { font-size: 24rpx; color: var(--md-on-surface-variant); } .voice-expired { font-size: 22rpx;
font-weight: 500; padding: 4rpx 12rpx; border-radius: 8rpx; background: var(--md-error-container); color:
var(--md-on-error-container); } /* FAB */ .fab-wrap { position: fixed; right: 40rpx; bottom: calc(160rpx +
env(safe-area-inset-bottom)); z-index: 100; } .fab { display: flex; align-items: center; gap: 12rpx; padding: 20rpx
32rpx; background: var(--md-primary); border-radius: 9999rpx; } .fab:active { opacity: 0.9; transform: scale(0.96); }
.fab md-icon { filter: brightness(0) invert(1); } .fab-text { font-size: 28rpx; font-weight: 600; color:
var(--md-on-primary); }
