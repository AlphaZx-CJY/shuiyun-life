/* 邻里互助列表页 */

.voice-list {
  padding: var(--space-2) var(--space-4);
}

.voice-item {
  padding: var(--space-4) 0;
  position: relative;
}

.voice-item--expired {
  opacity: 0.6;
}

.voice-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-2);
}

.voice-type-chip {
  font-size: 24rpx;
}

.voice-status {
  font-size: 24rpx;
  color: var(--md-error);
}

.voice-deadline {
  font-size: 24rpx;
  color: var(--md-on-surface-variant);
}

.voice-content {
  font-size: 30rpx;
  color: var(--md-on-surface);
  line-height: 1.6;
  display: block;
  margin-bottom: var(--space-2);
}

.voice-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.voice-date {
  font-size: 24rpx;
  color: var(--md-on-surface-variant);
}

.voice-contact {
  font-size: 24rpx;
  color: var(--md-primary);
}

/* Pill FAB */
.voice-fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  height: 96rpx;
  padding: 0 32rpx;
  border-radius: var(--radius-pill);
  background: var(--md-primary);
  color: var(--md-on-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  z-index: 100;
}

.voice-fab:active {
  transform: scale(0.96);
  background: linear-gradient(rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.12)), var(--md-primary);
}

.voice-fab-icon {
  font-size: 40rpx;
  font-weight: 300;
  line-height: 1;
}

.voice-fab-text {
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1;
}
