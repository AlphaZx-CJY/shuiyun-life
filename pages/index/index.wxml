<view class="page-container">
  <!-- 头部 -->
  <view class="header">
    <view class="header-title">新长宁水韵名邸</view>
    <view class="header-subtitle">让生活更便捷</view>
  </view>

  <!-- 班车信息卡片 -->
  <md-card class="shuttle-card-wrap" shape="xlarge" clickable wx:if="{{nextShuttle}}" bindtap="onShuttleBannerTap">
    <view class="shuttle-card-inner">
      <view class="shuttle-content">
        <view class="shuttle-tag">社区班车</view>
        <text class="shuttle-route">{{routeName}}</text>
        <view class="shuttle-time-wrap">
          <block wx:if="{{nextShuttle.status === 'passed'}}">
            <text class="shuttle-status passed">今日已结束</text>
          </block>
          <block wx:else>
            <text class="shuttle-time">{{nextShuttle.time}}</text>
            <text class="shuttle-status {{nextShuttle.status}}">{{nextShuttle.status === 'soon' ? '即将发车' : '下一班'}}</text>
          </block>
        </view>
      </view>
      <view class="shuttle-arrow">
        <view class="shuttle-arrow-icon"></view>
      </view>
    </view>
  </md-card>

  <!-- 快捷入口 -->
  <md-card class="quick-card-wrap" shape="large">
    <view class="quick-grid">
      <view class="quick-item" wx:for="{{quickEntries}}" wx:key="id" data-path="{{item.path}}" bindtap="onEntryTap">
        <view class="quick-icon-wrap">
          <md-icon wx:if="{{item.id === 1}}" name="/images/icons/material/storefront-on.svg" size="40" color="currentColor" />
          <md-icon wx:elif="{{item.id === 2}}" name="/images/icons/material/article-on.svg" size="40" color="currentColor" />
          <md-icon wx:elif="{{item.id === 3}}" name="/images/icons/material/event-on.svg" size="40" color="currentColor" />
          <md-icon wx:elif="{{item.id === 4}}" name="/images/icons/material/article-on.svg" size="40" color="currentColor" />
          <md-icon wx:elif="{{item.id === 5}}" name="/images/icons/material/storefront-on.svg" size="40" color="currentColor" />
          <md-icon wx:elif="{{item.id === 6}}" name="/images/icons/material/person-on.svg" size="40" color="currentColor" />
        </view>
        <text class="quick-label">{{item.label}}</text>
      </view>
    </view>
  </md-card>

  <!-- 社区通知 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">社区通知</text>
      <text class="section-more" bindtap="onMoreNoticeTap">查看更多</text>
    </view>
    <view class="list-container">
      <view class="list-item notice-item" wx:for="{{noticeNews}}" wx:key="id" data-id="{{item.id}}" bindtap="onNoticeTap">
        <view class="notice-tag">{{item.tag}}</view>
        <text class="notice-title">{{item.title}}</text>
        <view class="list-arrow"></view>
      </view>
      <view class="empty-state" wx:if="{{noticeNews.length === 0}}">
        <text class="empty-state__text">暂无社区通知</text>
      </view>
    </view>
  </view>

  <!-- 最近活动 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">最近活动</text>
      <text class="section-more" bindtap="onMoreScheduleTap">查看全部</text>
    </view>
    <view class="list-container">
      <view class="list-item schedule-item" wx:for="{{recentSchedules}}" wx:key="id" data-id="{{item.id}}" bindtap="onScheduleTap">
        <view class="schedule-dot schedule-dot--{{item.status}}"></view>
        <view class="schedule-content">
          <text class="schedule-title">{{item.title}}</text>
          <text class="schedule-info"><text class="schedule-date">{{item.dateLabel}}</text> · {{item.time}} · {{item.location}}</text>
        </view>
      </view>
      <view class="empty-state" wx:if="{{recentSchedules.length === 0}}">
        <text class="empty-state__text">暂无近期活动</text>
      </view>
    </view>
  </view>
</view>
