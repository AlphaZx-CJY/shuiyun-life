<view class="page-container page-container--with-tabbar">
  <!-- 头部 -->
  <view class="header">
    <view class="header-title">新长宁水韵名邸</view>
    <view class="header-subtitle">让生活更便捷</view>
  </view>

  <!-- 班车 Hero Card -->
  <view class="hero-card-wrap" wx:if="{{nextShuttle}}" bindtap="onShuttleBannerTap">
    <view class="hero-card">
      <view class="hero-content">
        <view class="hero-label">
          <md-icon name="/images/icons/material/directions_bus-on.svg" size="28" color="rgba(255,255,255,0.8)" />
          {{routeName}}
        </view>
        <view class="hero-countdown"
          >{{nextShuttle.allPassed ? '今日已结束' : (nextShuttle.minutesUntil > 0 ? (nextShuttle.minutesUntil > 100 ?
          '还有 ' + nextShuttle.hoursUntil + ' 小时 ' + nextShuttle.remainingMinutes + ' 分钟' : '还有 ' +
          nextShuttle.minutesUntil + ' 分钟') : nextShuttle.time)}}</view
        >
        <view class="hero-sub"
          >{{nextShuttle.allPassed ? '班车服务已结束' : (nextShuttle.status === 'soon' ? '即将发车' :
          (nextShuttle.minutesUntil > 0 ? '下一班车' : '末班车'))}}</view
        >
        <view class="hero-times" wx:if="{{!nextShuttle.allPassed}}">
          <view class="hero-time-pill {{nextShuttle.status === 'soon' ? 'hero-time-pill--highlight' : ''}}">
            <text class="hero-time-value">{{nextShuttle.time}}</text>
            <text wx:if="{{nextShuttle.status === 'soon'}}" class="hero-time-label">即将发车</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 社区通知 -->
  <view class="section-header">
    <text class="section-title">社区通知</text>
    <text class="section-more" bindtap="onMoreNoticeTap">查看全部</text>
  </view>
  <view class="notification-list">
    <view class="notification-card" wx:for="{{noticeNews}}" wx:key="id" data-id="{{item.id}}" bindtap="onNoticeTap">
      <view class="notification-content">
        <text class="notification-title">{{item.title}}</text>
        <text class="notification-date">{{item.date}}</text>
      </view>
    </view>
    <view class="empty-state empty-state--small" wx:if="{{noticeNews.length === 0}}">
      <text class="empty-state__text">暂无社区通知</text>
    </view>
  </view>

  <!-- 社区服务 -->
  <view class="section-header">
    <text class="section-title">社区服务</text>
  </view>
  <view class="quick-entry-bar">
    <!-- 周边生活：大椭圆 Pill -->
    <view class="quick-entry-pill" data-path="/pages/service/service" bindtap="onEntryTap">
      <md-icon name="/images/icons/material/storefront-outlined.svg" size="40" color="currentColor" />
      <text class="quick-entry-pill-text">周边生活</text>
    </view>
    <!-- 心声：大圆角正方形 Squircle -->
    <view class="quick-entry-squircle" data-path="/pages/voice/voice" bindtap="onEntryTap">
      <md-icon name="/images/icons/material/article-on.svg" size="40" color="currentColor" />
      <text class="quick-entry-squircle-text">心声</text>
    </view>
  </view>

  <!-- 最近活动 -->
  <view class="section-header">
    <text class="section-title">最近活动</text>
    <text class="section-more" bindtap="onMoreScheduleTap">查看全部</text>
  </view>
  <scroll-view class="event-scroll" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{recentSchedules.length > 0}}">
    <view class="event-list">
      <view class="event-card" wx:for="{{recentSchedules}}" wx:key="id" data-id="{{item.id}}" bindtap="onScheduleTap">
        <view
          class="event-color-area {{index % 3 === 0 ? 'event-color--primary' : index % 3 === 1 ? 'event-color--secondary' : 'event-color--tertiary'}}"
        >
          <md-icon name="/images/icons/material/event-on.svg" size="48" color="currentColor" />
        </view>
        <view class="event-info">
          <text class="event-tag">{{item.type || '活动'}}</text>
          <text class="event-title">{{item.title}}</text>
        </view>
      </view>
    </view>
  </scroll-view>
  <view class="empty-state empty-state--small" wx:if="{{recentSchedules.length === 0}}">
    <text class="empty-state__text">当前没有活动信息</text>
  </view>

  <!-- 班车信息弹窗 -->
  <view
    class="modal-overlay {{shuttleModalVisible ? '' : 'modal-overlay--hidden'}}"
    bindtap="onShuttleModalClose"
    catchtouchmove="preventTouchMove"
  >
    <view class="modal-sheet" catchtap="onModalSheetTap">
      <!-- 弹窗头部 -->
      <view class="modal-header">
        <text class="modal-title">班车信息</text>
        <view class="modal-close" bindtap="onShuttleModalClose">
          <md-icon name="/images/icons/material/close.svg" size="24" color="currentColor" />
        </view>
      </view>

      <!-- 弹窗内容 -->
      <view class="modal-body">
        <!-- 路线信息条 -->
        <view class="shuttle-info-bar">
          <text class="shuttle-info-name">{{routeName}}</text>
          <text class="shuttle-info-tag">{{runNote}}</text>
        </view>

        <!-- 下一班车 Hero — 弹窗视觉焦点 -->
        <view class="next-shuttle" wx:if="{{nextShuttle}}">
          <block wx:if="{{!nextShuttle.allPassed}}">
            <text class="next-shuttle-label">下一班车</text>
            <text class="next-shuttle-time">{{nextShuttle.time}}</text>
            <text class="next-shuttle-countdown" wx:if="{{nextShuttle.minutesUntil > 0}}">
              {{nextShuttle.minutesUntil > 100 ? '还有 ' + nextShuttle.hoursUntil + ' 小时 ' +
              nextShuttle.remainingMinutes + ' 分钟' : '还有 ' + nextShuttle.minutesUntil + ' 分钟'}}
            </text>
          </block>
          <block wx:if="{{nextShuttle.allPassed}}">
            <text class="next-shuttle-time">今日已结束</text>
            <text class="next-shuttle-countdown">明日 {{nextShuttle.firstShuttleTime}} 恢复</text>
          </block>
        </view>

        <!-- 全天时刻 — 次重点参考信息 -->
        <view class="time-rows">
          <view class="time-row">
            <view class="time-pill time-pill--{{item.status}}" wx:for="{{timeRow1}}" wx:key="time">
              <text class="time-pill-text">{{item.time}}</text>
            </view>
          </view>
          <view class="time-row">
            <view class="time-pill time-pill--{{item.status}}" wx:for="{{timeRow2}}" wx:key="time">
              <text class="time-pill-text">{{item.time}}</text>
            </view>
          </view>
        </view>

        <!-- 联系方式 — 底部按钮 -->
        <view class="contact-btn" wx:if="{{shuttleContactPhone}}" bindtap="onShuttleCallTap">
          <md-icon name="/images/icons/material/call-on.svg" size="20" color="currentColor" />
          <text class="contact-btn-text">{{shuttleContactPhone}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
