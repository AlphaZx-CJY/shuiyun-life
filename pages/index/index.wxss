/* 首页样式 — Material 3 Expressive (Colorful Containers) */ /* 头部 */ .header { padding: 64rpx 40rpx 40rpx; }
.header-title { font-size: 56rpx; font-weight: 700; color: var(--md-on-surface); letter-spacing: -0.8rpx; line-height:
1.15; } .header-subtitle { font-size: 24rpx; color: var(--md-on-surface-variant); margin-top: 12rpx; font-weight: 400; }
/* Hero Card — 纯色 + 几何装饰 */ .hero-card-wrap { margin: 0 40rpx 48rpx; } .hero-card { position: relative;
border-radius: 28rpx; overflow: hidden; height: 400rpx; background: var(--md-primary); } /* 右下角装饰圆 */
.hero-card::after { content: ''; position: absolute; right: -80rpx; bottom: -120rpx; width: 320rpx; height: 320rpx;
border-radius: 50%; background: var(--md-secondary-container); opacity: 0.25; } .hero-content { position: relative;
z-index: 1; padding: 48rpx; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; }
.hero-label { display: inline-flex; align-items: center; gap: 8rpx; font-size: 24rpx; font-weight: 500; color: rgba(255,
255, 255, 0.8); margin-bottom: 12rpx; } .hero-countdown { font-size: 64rpx; font-weight: 800; color:
var(--md-on-primary); line-height: 1.1; margin-bottom: 8rpx; letter-spacing: -1rpx; } .hero-sub { font-size: 28rpx;
color: rgba(255, 255, 255, 0.75); margin-bottom: 28rpx; } .hero-times { display: flex; gap: 20rpx; } .hero-time-pill {
text-align: center; background: rgba(255, 255, 255, 0.15); backdrop-filter: blur(16rpx); border-radius: 20rpx; padding:
16rpx 28rpx; min-width: 120rpx; } .hero-time-pill--highlight { background: rgba(255, 255, 255, 0.25); } .hero-time-value
{ font-size: 28rpx; font-weight: 700; color: var(--md-on-primary); } .hero-time-label { font-size: 20rpx; color:
rgba(255, 255, 255, 0.7); margin-top: 4rpx; display: block; } /* 快捷入口 — 统一圆形 */ .quick-row { display: flex;
justify-content: space-between; margin: 48rpx 40rpx 72rpx; padding: 0 16rpx; } .quick-item { display: flex;
flex-direction: column; align-items: center; gap: 20rpx; } .quick-icon-wrap { width: 112rpx; height: 112rpx;
border-radius: 50%; background: var(--md-primary-container); display: flex; align-items: center; justify-content:
center; transition: transform 100ms ease-out; } .quick-icon-wrap:active { transform: scale(0.92); } .quick-icon-wrap
md-icon { color: var(--md-on-primary-container); } .quick-label { font-size: 26rpx; color: var(--md-on-surface);
font-weight: 500; } /* Section Header */ .section-header { display: flex; justify-content: space-between; align-items:
baseline; margin: 0 40rpx 32rpx; } .section-title { font-size: 40rpx; font-weight: 700; color: var(--md-on-surface);
letter-spacing: -0.4rpx; } .section-more { font-size: 28rpx; color: var(--md-primary); font-weight: 500; } /* 通知列表 —
纵向卡片 + 左侧绿条 */ .notification-list { display: flex; flex-direction: column; gap: 24rpx; margin: 0 40rpx 72rpx; }
.notification-card { display: flex; align-items: flex-start; gap: 28rpx; background: var(--md-surface); border-radius:
28rpx; padding: 32rpx; position: relative; overflow: hidden; transition: transform 100ms ease-out; }
.notification-card:active { transform: scale(0.98); } /* 左侧 Primary 色竖条 */ .notification-card::before { content:
''; position: absolute; left: 0; top: 24rpx; bottom: 24rpx; width: 8rpx; background: var(--md-primary); border-radius: 0
4rpx 4rpx 0; } .notification-content { flex: 1; min-width: 0; padding-left: 16rpx; } .notification-title { font-size:
30rpx; font-weight: 600; color: var(--md-on-surface); line-height: 1.45; margin-bottom: 8rpx; display: block; }
.notification-date { font-size: 24rpx; color: var(--md-on-surface-variant); } /* 活动卡片 — 横向滚动彩色容器 */
.event-scroll { margin-bottom: 48rpx; } .event-list { display: flex; gap: 24rpx; padding: 0 40rpx; } .event-card {
min-width: 320rpx; height: 360rpx; border-radius: 28rpx; overflow: hidden; background: var(--md-surface); display: flex;
flex-direction: column; transition: transform 100ms ease-out; } .event-card:active { transform: scale(0.98); }
.event-color-area { height: 240rpx; display: flex; align-items: center; justify-content: center; position: relative; }
/* 装饰小圆 */ .event-color-area::after { content: ''; position: absolute; right: -40rpx; bottom: -40rpx; width: 120rpx;
height: 120rpx; border-radius: 50%; background: rgba(255, 255, 255, 0.2); } .event-color-area md-icon { position:
relative; z-index: 1; } .event-color--primary { background: var(--md-primary-container); } .event-color--primary md-icon
{ color: var(--md-on-primary-container); } .event-color--secondary { background: var(--md-secondary-container); }
.event-color--secondary md-icon { color: var(--md-on-secondary-container); } .event-color--tertiary { background:
var(--md-tertiary-container); } .event-color--tertiary md-icon { color: var(--md-on-tertiary-container); } .event-info {
padding: 24rpx 28rpx; flex: 1; display: flex; flex-direction: column; justify-content: center; } .event-tag { font-size:
22rpx; font-weight: 500; padding: 4rpx 16rpx; border-radius: 8rpx; background: var(--md-tag-bg); color:
var(--md-tag-text); margin-bottom: 8rpx; align-self: flex-start; } .event-title { font-size: 28rpx; font-weight: 600;
color: var(--md-on-surface); line-height: 1.3; } /* 空状态 */ .empty-state { display: flex; flex-direction: column;
align-items: center; justify-content: center; padding: 64rpx 32rpx 96rpx; } .empty-state--small { padding: 48rpx 32rpx
80rpx; } .empty-state__text { font-size: 28rpx; color: var(--md-on-surface-variant); line-height: 1.5; } /*
==================== 班车弹窗 ==================== */ .modal-overlay { position: fixed; top: 0; left: 0; right: 0;
bottom: 0; background: rgba(0, 0, 0, 0.4); display: flex; align-items: flex-end; justify-content: center; z-index: 200;
} .modal-sheet { width: 100%; background: var(--md-surface); border-radius: 28rpx 28rpx 0 0; padding: 40rpx 40rpx
calc(48rpx + env(safe-area-inset-bottom)); animation: slideUp 300ms ease-out; } @keyframes slideUp { from { transform:
translateY(100%); } to { transform: translateY(0); } } .modal-sheet__header { display: flex; align-items: center; gap:
16rpx; margin-bottom: 32rpx; } .modal-sheet__title { font-size: 36rpx; font-weight: 700; color: var(--md-on-surface); }
.modal-section { margin-bottom: 32rpx; } .modal-section__label { display: block; font-size: 26rpx; color:
var(--md-on-surface-variant); margin-bottom: 16rpx; font-weight: 500; } .modal-pills { display: flex; flex-wrap: wrap;
gap: 16rpx; } .modal-pill { background: var(--md-surface-container); padding: 10rpx 28rpx; border-radius: 9999rpx;
font-size: 26rpx; color: var(--md-on-surface-variant); } .time-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.time-grid__item { width: calc(25% - 12rpx); text-align: center; background: var(--md-surface-container); border-radius:
20rpx; padding: 20rpx 0; } .time-grid__item--highlight { background: var(--md-primary-container); } .time-grid__value {
font-size: 28rpx; font-weight: 700; color: var(--md-on-surface); display: block; } .time-grid__item--highlight
.time-grid__value { color: var(--md-on-primary-container); } .time-grid__label { font-size: 20rpx; color:
var(--md-primary); margin-top: 4rpx; display: block; } .modal-contact { display: flex; align-items: center; gap: 12rpx;
margin-top: 8rpx; font-size: 26rpx; color: var(--md-on-surface-variant); }
