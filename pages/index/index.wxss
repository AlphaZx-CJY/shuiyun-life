/* 首页样式 — Material 3 Expressive (Colorful Containers) */ /* 头部 */ .header { padding: 64rpx 40rpx 40rpx; }
.header-title { font-size: 56rpx; font-weight: 700; color: var(--md-on-surface); letter-spacing: -0.8rpx; line-height:
1.15; } .header-subtitle { font-size: 24rpx; color: var(--md-on-surface-variant); margin-top: 12rpx; font-weight: 400; }
/* Hero Card — 纯色 + 几何装饰 */ .hero-card-wrap { margin: 0 40rpx 48rpx; } .hero-card { position: relative;
border-radius: 28rpx; overflow: hidden; height: 400rpx; background: var(--md-primary); } /* 右下角装饰圆 */
.hero-card::after { content: ''; position: absolute; right: -80rpx; bottom: -120rpx; width: 320rpx; height: 320rpx;
border-radius: 50%; background: var(--md-secondary-container); opacity: 0.25; } .hero-content { position: relative;
z-index: 1; padding: 48rpx; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; }
.hero-label { display: inline-flex; align-items: center; gap: 12rpx; font-size: 24rpx; font-weight: 500; color:
rgba(255, 255, 255, 0.8); margin-bottom: 12rpx; } .hero-countdown { font-size: 64rpx; font-weight: 800; color:
var(--md-on-primary); line-height: 1.1; margin-bottom: 8rpx; letter-spacing: -1rpx; } .hero-sub { font-size: 28rpx;
color: rgba(255, 255, 255, 0.75); margin-bottom: 28rpx; } .hero-times { display: flex; gap: 20rpx; } .hero-time-pill {
text-align: center; background: rgba(255, 255, 255, 0.15); backdrop-filter: blur(16rpx); border-radius: 20rpx; padding:
16rpx 28rpx; min-width: 120rpx; } .hero-time-pill--highlight { background: rgba(255, 255, 255, 0.25); } .hero-time-value
{ font-size: 28rpx; font-weight: 700; color: var(--md-on-primary); } .hero-time-label { font-size: 20rpx; color:
rgba(255, 255, 255, 0.7); margin-top: 4rpx; display: block; } /* 社区服务 — 大椭圆 Pill + 大圆角正方形 */
.quick-entry-bar { display: flex; flex-direction: row; align-items: center; gap: 24rpx; margin: 0 40rpx 72rpx; }
.quick-entry-pill { flex: 2; height: 120rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx;
background: var(--md-primary); border-radius: 9999rpx; transition: opacity 100ms ease-out; } .quick-entry-pill:active {
opacity: 0.85; } .quick-entry-pill md-icon { color: var(--md-on-primary); } .quick-entry-pill-text { font-size: 28rpx;
font-weight: 600; color: var(--md-on-primary); } .quick-entry-squircle { flex: 1; height: 120rpx; display: flex;
flex-direction: row; align-items: center; justify-content: center; gap: 12rpx; background:
var(--md-secondary-container); border-radius: 32rpx; transition: transform 100ms ease-out; }
.quick-entry-squircle:active { transform: scale(0.95); } .quick-entry-squircle md-icon { color:
var(--md-on-secondary-container); } .quick-entry-squircle-text { font-size: 24rpx; font-weight: 500; color:
var(--md-on-secondary-container); } /* Section Header */ .section-header { display: flex; justify-content:
space-between; align-items: baseline; margin: 0 40rpx 32rpx; } .section-title { font-size: 40rpx; font-weight: 700;
color: var(--md-on-surface); letter-spacing: -0.4rpx; } .section-more { font-size: 28rpx; color: var(--md-primary);
font-weight: 500; } /* 通知列表 — 纵向卡片 + 左侧绿条 */ .notification-list { display: flex; flex-direction: column;
gap: 24rpx; margin: 0 40rpx 72rpx; } .notification-card { display: flex; align-items: flex-start; gap: 28rpx;
background: var(--md-surface); border-radius: 28rpx; padding: 32rpx; position: relative; overflow: hidden; transition:
transform 100ms ease-out; } .notification-card:active { transform: scale(0.98); } /* 左侧 Primary 色竖条 */
.notification-card::before { content: ''; position: absolute; left: 0; top: 24rpx; bottom: 24rpx; width: 8rpx;
background: var(--md-primary); border-radius: 0 4rpx 4rpx 0; } .notification-content { flex: 1; min-width: 0;
padding-left: 16rpx; } .notification-title { font-size: 30rpx; font-weight: 600; color: var(--md-on-surface);
line-height: 1.45; margin-bottom: 8rpx; display: block; } .notification-date { font-size: 24rpx; color:
var(--md-on-surface-variant); } /* 活动卡片 — 横向滚动彩色容器 */ .event-scroll { margin-bottom: 48rpx; } .event-list {
display: flex; gap: 24rpx; padding: 0 40rpx; } .event-card { min-width: 320rpx; height: 360rpx; border-radius: 28rpx;
overflow: hidden; background: var(--md-surface); display: flex; flex-direction: column; transition: transform 100ms
ease-out; } .event-card:active { transform: scale(0.98); } .event-color-area { height: 240rpx; display: flex;
align-items: center; justify-content: center; position: relative; } /* 装饰小圆 */ .event-color-area::after { content:
''; position: absolute; right: -40rpx; bottom: -40rpx; width: 120rpx; height: 120rpx; border-radius: 50%; background:
rgba(255, 255, 255, 0.2); } .event-color-area md-icon { position: relative; z-index: 1; } .event-color--primary {
background: var(--md-primary-container); } .event-color--primary md-icon { color: var(--md-on-primary-container); }
.event-color--secondary { background: var(--md-secondary-container); } .event-color--secondary md-icon { color:
var(--md-on-secondary-container); } .event-color--tertiary { background: var(--md-tertiary-container); }
.event-color--tertiary md-icon { color: var(--md-on-tertiary-container); } .event-info { padding: 24rpx 28rpx; flex: 1;
display: flex; flex-direction: column; justify-content: center; } .event-tag { font-size: 22rpx; font-weight: 500;
padding: 4rpx 16rpx; border-radius: 8rpx; background: var(--md-tag-bg); color: var(--md-tag-text); margin-bottom: 8rpx;
align-self: flex-start; } .event-title { font-size: 28rpx; font-weight: 600; color: var(--md-on-surface); line-height:
1.3; } /* 空状态 */ .empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center;
padding: 64rpx 32rpx 96rpx; } .empty-state--small { padding: 48rpx 32rpx 80rpx; } .empty-state__text { font-size: 28rpx;
color: var(--md-on-surface-variant); line-height: 1.5; } /* 弹窗 — Bottom Sheet + 滑入动画 */ .modal-overlay { position:
fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.4); z-index: 1000; display: flex;
flex-direction: column; justify-content: flex-end; opacity: 1; transition: opacity 250ms ease; } .modal-overlay--hidden
{ opacity: 0; pointer-events: none; } .modal-sheet { background: var(--md-surface); border-radius: 28rpx 28rpx 0 0;
max-height: 92vh; display: flex; flex-direction: column; padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
transform: translateY(0); transition: transform 300ms cubic-bezier(0.32, 0.72, 0, 1); } .modal-overlay--hidden
.modal-sheet { transform: translateY(100%); } .modal-header { display: flex; align-items: center; justify-content:
space-between; padding: 20rpx 32rpx; border-bottom: 1rpx solid var(--md-outline-variant); } .modal-title { font-size:
32rpx; font-weight: 700; color: var(--md-on-surface); } .modal-close { width: 48rpx; height: 48rpx; display: flex;
align-items: center; justify-content: center; } .modal-body { flex: 1; padding: 20rpx 32rpx calc(32rpx +
env(safe-area-inset-bottom)); } /* 顶部信息条 */ .shuttle-info-bar { display: flex; align-items: center; gap: 12rpx;
margin-bottom: 20rpx; } .shuttle-info-name { font-size: 28rpx; font-weight: 700; color: var(--md-on-surface); }
.shuttle-info-tag { font-size: 22rpx; font-weight: 500; padding: 4rpx 14rpx; border-radius: 9999rpx; background:
var(--md-primary-container); color: var(--md-on-primary-container); } /* 下一班车 Hero — 弹窗视觉焦点 */ .next-shuttle {
text-align: center; background: var(--md-primary-container); border-radius: 20rpx; padding: 32rpx; margin-bottom: 20rpx;
} .next-shuttle-label { font-size: 24rpx; color: var(--md-on-primary-container); margin-bottom: 8rpx; display: block; }
.next-shuttle-time { font-size: 48rpx; font-weight: 800; color: var(--md-on-primary-container); line-height: 1.2;
display: block; } .next-shuttle-countdown { font-size: 24rpx; color: var(--md-primary); margin-top: 8rpx; display:
block; } .next-shuttle-countdown--ended { color: var(--md-on-surface-variant); } /* 全天时刻 — 次重点参考信息 */
.time-rows { display: flex; flex-direction: column; gap: 12rpx; background: var(--md-surface-container); border-radius:
16rpx; padding: 20rpx; margin-bottom: 20rpx; } .time-row { display: flex; gap: 12rpx; } .time-row .time-pill { flex: 1;
display: flex; align-items: center; justify-content: center; padding: 10rpx 0; border-radius: 9999rpx; background:
var(--md-surface-container-high); } .time-pill--passed { background: var(--md-surface-container-high); opacity: 0.5; }
.time-pill--passed .time-pill-text { text-decoration: line-through; } .time-pill--soon { background: var(--md-primary);
} .time-pill--upcoming { background: var(--md-surface-container-high); } .time-pill-text { font-size: 24rpx;
font-weight: 600; color: var(--md-on-surface); } .time-pill--soon .time-pill-text { color: var(--md-on-primary); } /*
联系方式 — 底部按钮（弱化但不失按钮形态） */ .contact-btn { display: flex; align-items: center; justify-content: center;
gap: 8rpx; padding: 20rpx 0; background: var(--md-surface-container); border-radius: 16rpx; } .contact-btn md-icon {
color: var(--md-on-surface-variant); } .contact-btn-text { font-size: 26rpx; font-weight: 500; color:
var(--md-on-surface); } /* ========== Skeleton ========== */ @keyframes skeleton-pulse { 0%, 100% { opacity: 1; } 50% {
opacity: 0.55; } } .skeleton-line { height: 28rpx; border-radius: 8rpx; background: var(--md-surface-container);
animation: skeleton-pulse 1.6s ease-in-out infinite; } .skeleton-line--short { width: 30%; } .skeleton-line--medium {
width: 50%; } .skeleton-line--long { width: 80%; } /* 班车 Hero 骨架 */ .hero-skeleton { margin: 0 40rpx 32rpx; }
.skeleton-hero-card { background: var(--md-surface-container); border-radius: 28rpx; padding: 32rpx; } /* 通知骨架 */
.notification-card.skeleton-card { background: var(--md-surface); } .notification-card.skeleton-card .skeleton-line {
background: var(--md-surface-container-high); } /* 活动骨架 */ .skeleton-color-area { width: 160rpx; height: 160rpx;
border-radius: 24rpx; background: var(--md-surface-container); flex-shrink: 0; animation: skeleton-pulse 1.6s
ease-in-out infinite; } .event-card.skeleton-card .event-info { justify-content: center; } .event-card.skeleton-card
.skeleton-line { background: var(--md-surface-container-high); }
