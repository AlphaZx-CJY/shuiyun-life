/* 首页样式 — Material 3 Expressive */


/* 头部 */
.header {
  padding: 64rpx 32rpx 32rpx;
}

.header-title {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--md-on-surface);
  letter-spacing: -0.8rpx;
  line-height: 1.15;
}

.header-subtitle {
  font-size: 28rpx;
  color: var(--md-on-surface-variant);
  margin-top: 12rpx;
  font-weight: 400;
}

/* 班车卡片 */
.shuttle-card-wrap {
  margin: 0 32rpx;
}

.shuttle-card-inner {
  height: 340rpx;
  background: linear-gradient(135deg, var(--md-primary) 0%, var(--md-on-primary-container) 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40rpx;
  position: relative;
  overflow: hidden;
}

.shuttle-card-inner::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 50%;
}

.shuttle-card-inner::after {
  content: '';
  position: absolute;
  bottom: -40rpx;
  left: -40rpx;
  width: 160rpx;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 50%;
}

.shuttle-content {
  display: flex;
  flex-direction: column;
  z-index: 1;
}

.shuttle-tag {
  display: inline-flex;
  align-self: flex-start;
  padding: 6rpx 18rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 9999rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: var(--md-on-primary);
  margin-bottom: 16rpx;
  backdrop-filter: blur(8rpx);
}

.shuttle-route {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--md-on-primary);
  letter-spacing: 0.2rpx;
  margin-bottom: 16rpx;
}

.shuttle-time-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.shuttle-time {
  font-size: 56rpx;
  font-weight: 300;
  color: var(--md-on-primary);
  letter-spacing: -1rpx;
  line-height: 1;
}

.shuttle-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 16rpx;
  border-radius: 9999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.shuttle-status.soon {
  background: rgba(255, 255, 255, 0.25);
  color: var(--md-on-primary);
}

.shuttle-status.upcoming {
  background: rgba(255, 255, 255, 0.15);
  color: rgba(255, 255, 255, 0.9);
}

.shuttle-status.passed {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.6);
}

.shuttle-arrow {
  z-index: 1;
}

.shuttle-arrow-icon {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid rgba(255, 255, 255, 0.6);
  border-right: 3rpx solid rgba(255, 255, 255, 0.6);
  transform: rotate(45deg);
}

/* 快捷入口 */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
  margin: 48rpx 32rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-icon-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: var(--md-surface-container-high);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 100ms ease-out, transform 100ms ease-out;
}

.quick-icon-btn:active {
  background-color: var(--md-surface-container-highest);
  transform: scale(0.96);
}

.quick-label {
  font-size: 24rpx;
  color: var(--md-on-surface);
  font-weight: 500;
  margin-top: 12rpx;
}

/* 分区 */
.section {
  margin: 48rpx 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--md-on-surface);
  letter-spacing: -0.2rpx;
}

.section-more {
  font-size: 24rpx;
  color: var(--md-primary);
  font-weight: 500;
}

/* 列表项 */
.list-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  position: relative;
}

.list-item::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: var(--md-outline-variant);
  transform: scaleY(0.5);
}

.list-item:last-child::after {
  display: none;
}

.list-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid var(--md-outline);
  border-right: 3rpx solid var(--md-outline);
  transform: rotate(45deg);
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* 社区通知 */
.notice-tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  background: var(--md-error-container);
  color: var(--md-error);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.notice-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--md-on-surface);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: -0.2rpx;
}

/* 活动项 */
.schedule-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.schedule-dot--upcoming {
  background: var(--md-primary);
}

.schedule-dot--ongoing {
  background: var(--md-outline);
}

.schedule-dot--ended {
  background: var(--md-outline-variant);
}

.schedule-content {
  flex: 1;
  min-width: 0;
}

.schedule-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--md-on-surface);
  display: block;
  letter-spacing: -0.2rpx;
}

.schedule-info {
  font-size: 24rpx;
  color: var(--md-on-surface-variant);
  margin-top: 6rpx;
  display: block;
  font-weight: 400;
}

.schedule-date {
  color: var(--md-primary);
  font-weight: 600;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64rpx 32rpx;
}

.empty-state__text {
  font-size: 28rpx;
  color: var(--md-on-surface-variant);
  line-height: 1.5;
}
