/* 闲置交易页样式 */

.category-bar {
  background: var(--md-surface);
  padding: 24rpx 32rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.category-scroll {
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  gap: 16rpx;
}

.trade-list {
  padding: 0 32rpx;
}

.trade-item {
  display: flex;
  padding: 32rpx 0;
  border-bottom: 1rpx solid var(--md-outline-variant);
}

.trade-item:last-child {
  border-bottom: none;
}

.trade-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: var(--md-surface-container);
}

.trade-image--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.trade-placeholder-icon {
  width: 64rpx;
  height: 64rpx;
  opacity: 0.4;
}

.trade-info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.trade-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--md-on-surface);
  line-height: 1.4;
}

.trade-price-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-top: auto;
  margin-bottom: 12rpx;
}

.trade-price {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--md-primary);
}

.trade-original {
  font-size: 24rpx;
  color: var(--md-on-surface-variant);
  text-decoration: line-through;
}

.trade-meta {
  display: flex;
  justify-content: space-between;
}

.trade-seller,
.trade-time {
  font-size: 22rpx;
  color: var(--md-on-surface-variant);
}

.fab-wrap {
  position: fixed;
  right: 32rpx;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.page-container {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}
