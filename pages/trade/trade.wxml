<view class="page-container page-container--with-tabbar">
  <!-- 分类筛选 -->
  <view class="category-pill-bar">
    <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="category-pill-list">
        <view
          class="category-pill-item {{activeCategory === item.id ? 'category-pill-item--active' : ''}}"
          wx:for="{{categories}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onCategoryTap"
        >
          {{item.name}}
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- Skeleton (initial load) -->
  <view class="trade-waterfall" wx:if="{{loading && allTrades.length === 0}}">
    <view class="trade-column">
      <view class="trade-card skeleton-card" wx:for="{{[1,2]}}" wx:key="*this">
        <view class="skeleton-image"></view>
        <view class="skeleton-info">
          <view class="skeleton-line skeleton-line--short"></view>
          <view class="skeleton-line skeleton-line--medium"></view>
        </view>
      </view>
    </view>
    <view class="trade-column">
      <view class="trade-card skeleton-card" wx:for="{{[1,2]}}" wx:key="*this">
        <view class="skeleton-image"></view>
        <view class="skeleton-info">
          <view class="skeleton-line skeleton-line--short"></view>
          <view class="skeleton-line skeleton-line--medium"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 交易列表 — 双列瀑布流 -->
  <view class="trade-waterfall" wx:if="{{tradeList.length > 0}}">
    <view class="trade-column">
      <view class="trade-card" wx:for="{{leftColumn}}" wx:key="id" data-id="{{item.id}}" bindtap="onTradeTap">
        <view
          class="trade-color-area {{item.category === 'furniture' ? 'trade-color--primary' : item.category === 'appliance' ? 'trade-color--tertiary' : item.category === 'baby' ? 'trade-color--baby' : item.category === 'books' ? 'trade-color--secondary' : 'trade-color--other'}}"
          wx:if="{{!item.images || !item.images.length || item.imageError}}"
        >
          <md-icon
            name="/images/icons/material/{{item.category === 'furniture' ? 'chair' : item.category === 'appliance' ? 'tv' : item.category === 'baby' ? 'child_care' : item.category === 'books' ? 'book' : 'electric_bolt'}}.svg"
            size="64"
            color="currentColor"
          />
        </view>
        <image
          wx:if="{{item.images && item.images.length && !item.imageError}}"
          class="trade-card-image"
          src="{{item.images[0]}}"
          mode="aspectFill"
          lazy-load
          data-id="{{item.id}}"
          binderror="onImageError"
        />
        <view class="trade-info">
          <text class="trade-category">{{item.categoryName}}</text>
          <text class="trade-title">{{item.title}}</text>
          <view class="trade-price-row">
            <text class="trade-price">¥{{item.price}}</text>
            <text class="trade-original" wx:if="{{item.originalPrice}}">¥{{item.originalPrice}}</text>
          </view>
          <view class="trade-meta-row">
            <text class="trade-seller">{{item.seller}}</text>
            <text class="trade-discount" wx:if="{{item.discount > 0}}">省{{item.discount}}%</text>
          </view>
        </view>
      </view>
    </view>
    <view class="trade-column">
      <view class="trade-card" wx:for="{{rightColumn}}" wx:key="id" data-id="{{item.id}}" bindtap="onTradeTap">
        <view
          class="trade-color-area {{item.category === 'furniture' ? 'trade-color--primary' : item.category === 'appliance' ? 'trade-color--tertiary' : item.category === 'baby' ? 'trade-color--baby' : item.category === 'books' ? 'trade-color--secondary' : 'trade-color--other'}}"
          wx:if="{{!item.images || !item.images.length || item.imageError}}"
        >
          <md-icon
            name="/images/icons/material/{{item.category === 'furniture' ? 'chair' : item.category === 'appliance' ? 'tv' : item.category === 'baby' ? 'child_care' : item.category === 'books' ? 'book' : 'electric_bolt'}}.svg"
            size="64"
            color="currentColor"
          />
        </view>
        <image
          wx:if="{{item.images && item.images.length && !item.imageError}}"
          class="trade-card-image"
          src="{{item.images[0]}}"
          mode="aspectFill"
          lazy-load
          data-id="{{item.id}}"
          binderror="onImageError"
        />
        <view class="trade-info">
          <text class="trade-category">{{item.categoryName}}</text>
          <text class="trade-title">{{item.title}}</text>
          <view class="trade-price-row">
            <text class="trade-price">¥{{item.price}}</text>
            <text class="trade-original" wx:if="{{item.originalPrice}}">¥{{item.originalPrice}}</text>
          </view>
          <view class="trade-meta-row">
            <text class="trade-seller">{{item.seller}}</text>
            <text class="trade-discount" wx:if="{{item.discount > 0}}">省{{item.discount}}%</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <md-empty-state
    wx:if="{{tradeList.length === 0 && !loading}}"
    icon="/images/icons/material/storefront-off.svg"
    headline="暂无闲置物品"
    supportingText="快去发布第一件闲置吧"
  />

  <!-- 发布 FAB -->
  <view class="fab-wrap">
    <md-fab icon="/images/icons/material/storefront-on.svg" bind:tap="onPublishTap" />
  </view>
</view>
