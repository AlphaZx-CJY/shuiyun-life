<md-app-bar title="意见反馈" showBack="{{true}}" />

<view class="page-container">
  <view class="form-body">
    <!-- 反馈类型 -->
    <view class="form-item">
      <text class="form-label">反馈类型</text>
      <picker mode="selector" range="{{types}}" value="{{typeIndex}}" bindchange="onTypeChange">
        <view class="form-picker">
          <text class="form-picker-text">{{types[typeIndex]}}</text>
          <view class="picker-arrow"></view>
        </view>
      </picker>
    </view>

    <!-- 反馈内容 -->
    <view class="form-item">
      <md-text-field
        label="反馈内容 *"
        placeholder="请描述您在使用小程序时遇到的问题或建议..."
        value="{{content}}"
        maxlength="500"
        multiline
        bind:input="onContentInput"
      />
      <text class="form-counter">{{content.length}}/500</text>
    </view>

    <!-- 联系方式 -->
    <view class="form-item">
      <md-text-field
        label="联系方式（选填）"
        placeholder="手机号或微信号，方便我们回复您"
        value="{{contact}}"
        bind:input="onContactInput"
      />
    </view>
  </view>

  <view class="form-actions">
    <view class="btn-pill btn-pill--primary {{submitting ? 'btn-pill--disabled' : ''}}" bindtap="onSubmit">
      {{submitting ? '提交中...' : '提交反馈'}}
    </view>
  </view>
</view>
