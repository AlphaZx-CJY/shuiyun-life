<md-app-bar title="意见反馈" showBack="{{true}}" />

<view class="page-container">
  <md-card shape="large" class="feedback-card">
    <view class="form-group">
      <text class="form-label">反馈类型</text>
      <picker mode="selector" range="{{types}}" value="{{typeIndex}}" bindchange="onTypeChange">
        <view class="form-picker">
          <text class="form-picker-text">{{types[typeIndex]}}</text>
          <view class="picker-arrow"></view>
        </view>
      </picker>
    </view>

    <md-divider inset />

    <view class="form-group">
      <text class="form-label">反馈内容</text>
      <textarea
        class="form-textarea"
        placeholder="请描述您在使用小程序时遇到的问题或建议..."
        maxlength="500"
        bindinput="onContentInput"
        value="{{content}}"
      ></textarea>
      <text class="form-counter">{{content.length}}/500</text>
    </view>

    <md-divider inset />

    <view class="form-group">
      <text class="form-label">联系方式（选填）</text>
      <input
        class="form-input"
        placeholder="手机号或微信号，方便我们回复您"
        bindinput="onContactInput"
        value="{{contact}}"
      />
    </view>
  </md-card>

  <view class="feedback-actions">
    <view class="btn-pill btn-pill--primary {{submitting ? 'btn-pill--disabled' : ''}}" bindtap="onSubmit">
      {{submitting ? '提交中...' : '提交反馈'}}
    </view>
  </view>
</view>
