/* 活动详情页样式 */

.detail-header {
  padding: 48rpx 32rpx 32rpx;
}

.detail-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--md-on-surface);
  line-height: 1.3;
  margin-top: 20rpx;
  letter-spacing: -0.4rpx;
}

.detail-status-wrap {
  margin-top: 16rpx;
}

.detail-status {
  display: inline-flex;
  padding: 8rpx 20rpx;
  border-radius: 9999rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.detail-status--upcoming {
  background: var(--md-primary-container);
  color: var(--md-on-primary-container);
}

.detail-status--ended {
  background: var(--md-surface-variant);
  color: var(--md-on-surface-variant);
}

.detail-info-card {
  margin: 32rpx;
  padding: 24rpx 32rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--md-outline-variant);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: var(--md-on-surface-variant);
}

.info-value {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--md-on-surface);
}

.detail-desc-section {
  margin: 32rpx;
  padding: 0 0 48rpx;
}

.detail-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--md-on-surface);
  display: block;
  margin-bottom: 16rpx;
}

.detail-desc-text {
  font-size: 28rpx;
  color: var(--md-on-surface-variant);
  line-height: 1.75;
  display: block;
}

.empty-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}
