/* 复用 voice 页卡片样式 */ .page-container { padding-top: 20rpx; } .voice-list { padding: 0 40rpx; } /* Skeleton */
@keyframes skeleton-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.55; } } .skeleton-card { background:
var(--md-surface); } .skeleton-icon { width: 160rpx; height: 160rpx; border-radius: 24rpx; background:
var(--md-surface-container); flex-shrink: 0; animation: skeleton-pulse 1.6s ease-in-out infinite; } .skeleton-content {
flex: 1; display: flex; flex-direction: column; gap: 20rpx; justify-content: center; } .skeleton-line { height: 32rpx;
border-radius: 8rpx; background: var(--md-surface-container); animation: skeleton-pulse 1.6s ease-in-out infinite; }
.skeleton-line--short { width: 40%; } .skeleton-line--long { width: 90%; } .skeleton-line--medium { width: 60%; }
.voice-card { display: flex; gap: 28rpx; background: var(--md-surface); border-radius: 28rpx; padding: 28rpx;
margin-bottom: 28rpx; transition: transform 100ms ease-out; } .voice-card:active { transform: scale(0.98); }
.voice-icon-box { width: 160rpx; height: 160rpx; border-radius: 24rpx; flex-shrink: 0; display: flex; align-items:
center; justify-content: center; position: relative; overflow: hidden; background: var(--md-voice-container); }
.voice-icon-box::after { content: ''; position: absolute; right: -30rpx; bottom: -30rpx; width: 80rpx; height: 80rpx;
border-radius: 50%; background: rgba(255, 255, 255, 0.25); } .voice-icon-box md-icon { color:
var(--md-voice-on-container); position: relative; z-index: 1; } .voice-content { flex: 1; display: flex; flex-direction:
column; justify-content: center; min-width: 0; } .voice-header { display: flex; align-items: center; gap: 16rpx;
margin-bottom: 12rpx; } .voice-tag { font-size: 22rpx; font-weight: 500; padding: 4rpx 16rpx; border-radius: 8rpx;
background: var(--md-voice-container); color: var(--md-voice-on-container); } .voice-date { font-size: 24rpx; color:
var(--md-on-surface-variant); } .voice-title { font-size: 30rpx; font-weight: 600; color: var(--md-on-surface);
line-height: 1.4; margin-bottom: 12rpx; overflow: hidden; text-overflow: ellipsis; display: -webkit-box;
-webkit-line-clamp: 2; -webkit-box-orient: vertical; } .voice-meta { display: flex; align-items: center; gap: 16rpx; }
.voice-deadline { font-size: 24rpx; color: var(--md-on-surface-variant); } .voice-expired { font-size: 22rpx;
font-weight: 500; padding: 4rpx 12rpx; border-radius: 8rpx; background: var(--md-error-container); color:
var(--md-on-error-container); } /* 帮助提示 */ .help-tip { margin: 32rpx 40rpx 0; padding: 24rpx; background:
var(--md-surface-container); border-radius: 16rpx; } .help-tip-text { font-size: 24rpx; color:
var(--md-on-surface-variant); line-height: 1.5; display: block; }
