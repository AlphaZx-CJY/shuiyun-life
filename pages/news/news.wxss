/* 资讯页样式 */


/* 分类标签栏 */
.category-pill-bar {
  padding: 16rpx 32rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--md-background);
}

.category-scroll {
  white-space: nowrap;
}

.category-pill-list {
  display: inline-flex;
  gap: 8rpx;
  padding: 8rpx;
  background: var(--md-surface-container);
  border-radius: 9999rpx;
}

.category-pill-item {
  padding: 12rpx 28rpx;
  border-radius: 9999rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--md-on-surface-variant);
  white-space: nowrap;
  transition: background-color 100ms ease-out, color 100ms ease-out;
}

.category-pill-item--active {
  background: var(--md-primary);
  color: #FFFFFF;
}

/* 新闻列表 */
.news-list {
  padding: 0 32rpx;
}

.news-item {
  display: flex;
  padding: 32rpx 0;
}

.news-item__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.news-item__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.news-item__tag {
  display: inline-flex;
  padding: 6rpx 12rpx;
  background: var(--md-primary-container);
  color: var(--md-on-primary-container);
  border-radius: 4rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
}

.news-item__date {
  font-size: 22rpx;
  color: var(--md-on-surface-variant);
}

.news-item__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--md-on-surface);
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.news-item__summary {
  font-size: 26rpx;
  color: var(--md-on-surface-variant);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 16rpx;
}

.news-item__footer {
  margin-top: auto;
}

.news-item__source {
  font-size: 22rpx;
  color: var(--md-on-surface-variant);
}

.news-item__cover {
  width: 200rpx;
  height: 160rpx;
  border-radius: 20rpx;
  margin-left: 24rpx;
  flex-shrink: 0;
  background: var(--md-surface-variant);
}

/* 空状态 */
.empty-state {
  padding: 96rpx 32rpx;
}
