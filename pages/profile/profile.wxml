<view class="page-container page-container--with-tabbar">
  <!-- 用户头部 -->
  <view class="profile-header">
    <view class="profile-avatar">
      <text class="profile-avatar-text">居</text>
    </view>
    <text class="profile-name">水韵名邸业主</text>
    <text class="profile-address">新长宁水韵名邸</text>
  </view>

  <!-- 功能列表 -->
  <view class="profile-section">
    <view class="profile-list">
      <view class="profile-list-item" wx:for="{{aboutItems}}" wx:key="id" data-item="{{item}}" bindtap="onItemTap">
        <view class="profile-list-left">
          <view class="profile-list-icon">
            <md-icon name="{{item.icon}}" size="40" color="currentColor" />
          </view>
          <text class="profile-list-title">{{item.title}}</text>
        </view>
        <text class="profile-list-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 版本信息 -->
  <view class="version-info">
    <text>水韵名邸生活号 v{{version}}</text>
    <text>由个人维护</text>
  </view>
</view>
