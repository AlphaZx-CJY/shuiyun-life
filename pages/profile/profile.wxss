/* 更多页面 — Material 3 Expressive */ .profile-header { display: flex; flex-direction: column; align-items: center;
padding: 80rpx 40rpx 64rpx; background: var(--md-background); } .profile-avatar { width: 128rpx; height: 128rpx;
border-radius: 50%; background: var(--md-primary-container); display: flex; align-items: center; justify-content:
center; margin-bottom: 28rpx; } .profile-avatar-text { font-size: 48rpx; font-weight: 700; color:
var(--md-on-primary-container); } .profile-name { font-size: 36rpx; font-weight: 700; color: var(--md-on-surface);
margin-bottom: 8rpx; } .profile-address { font-size: 26rpx; color: var(--md-on-surface-variant); } .profile-section {
margin: 0 40rpx 48rpx; } .profile-list { background: var(--md-surface); border-radius: 28rpx; overflow: hidden; }
.profile-list-item { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 32rpx;
border-bottom: 1rpx solid var(--md-outline-variant); transition: background-color 100ms ease; }
.profile-list-item:last-child { border-bottom: none; } .profile-list-item:active { background:
var(--md-surface-container-low); } .profile-list-left { display: flex; align-items: center; gap: 28rpx; }
.profile-list-icon { width: 72rpx; height: 72rpx; border-radius: 20rpx; background: var(--md-surface-container);
display: flex; align-items: center; justify-content: center; } .profile-list-icon md-icon { color:
var(--md-on-surface-variant); } .profile-list-title { font-size: 30rpx; color: var(--md-on-surface); font-weight: 500; }
.profile-list-arrow { font-size: 36rpx; color: var(--md-arrow); } .version-info { display: flex; flex-direction: column;
align-items: center; padding: 48rpx 40rpx; gap: 8rpx; } .version-info text { font-size: 22rpx; color:
var(--md-on-surface-variant); } .profile-section-title { font-size: 26rpx; font-weight: 600; color:
var(--md-on-surface-variant); margin: 0 40rpx 16rpx; display: block; }
