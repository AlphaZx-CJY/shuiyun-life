/* 我的页面样式 */

.profile-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 32rpx 48rpx;
  background: var(--md-background);
}

.profile-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--md-surface-variant);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.profile-logo {
  width: 120rpx;
  height: 120rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--md-on-surface);
  margin-bottom: 8rpx;
}

.profile-address {
  font-size: 26rpx;
  color: var(--md-on-surface-variant);
}

.profile-section {
  margin: var(--space-4) var(--space-4) var(--space-6);
}

.profile-list {
  background: var(--md-surface);
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.version-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  gap: 8rpx;
}

.version-info text {
  font-size: 22rpx;
  color: var(--md-on-surface-variant);
}

/* Custom tab-bar padding */
.page-container {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}
