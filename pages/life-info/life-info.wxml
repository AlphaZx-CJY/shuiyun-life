<md-app-bar title="周边生活" showBack="{{true}}" />

<view class="page-container">
  <!-- 分类标签 -->
  <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="category-bar">
      <md-chip wx:for="{{categories}}" wx:key="id"
        variant="filled"
        active="{{activeCategory === item.id}}"
        data-id="{{item.id}}"
        bindtap="onCategoryTap"
        class="category-chip">
        {{item.name}}
      </md-chip>
    </view>
  </scroll-view>

  <!-- 服务列表 -->
  <view class="service-list" wx:if="{{serviceList.length > 0}}">
    <view class="service-item" wx:for="{{serviceList}}" wx:key="id" data-item="{{item}}" bindtap="onServiceTap">
      <view class="service-main">
        <view class="service-header">
          <text class="service-name">{{item.name}}</text>
          <text class="service-distance">{{item.distance}}</text>
        </view>
        <view class="service-tags">
          <md-chip wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" variant="outlined" class="service-tag">{{tag}}</md-chip>
        </view>
        <view class="service-info">
          <view class="service-info-row">
            <text class="service-info-label">地址</text>
            <text class="service-info-value">{{item.address}}</text>
          </view>
          <view class="service-info-row">
            <text class="service-info-label">营业时间</text>
            <view class="service-info-value">
              <view wx:for="{{item.hours}}" wx:for-item="h" wx:key="*this">{{h}}</view>
            </view>
          </view>
        </view>
      </view>
      <view class="service-footer" wx:if="{{item.phone}}">
        <view class="btn-pill btn-pill--primary btn-pill--small" catchtap="onPhoneTap" data-phone="{{item.phone}}">
          拨打电话
        </view>
      </view>
      <md-divider wx:if="{{index < serviceList.length - 1}}" />
    </view>
  </view>

  <!-- 空状态 -->
  <md-empty-state wx:if="{{serviceList.length === 0}}"
    icon="/images/icons/profile/help.svg"
    headline="该分类下暂无服务"
    supporting-text="试试切换其他分类看看" />
</view>
