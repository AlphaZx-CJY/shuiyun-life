/* 周边生活页样式 */

.category-scroll {
  white-space: nowrap;
  background: var(--md-surface);
  margin-top: var(--space-2);
  margin-bottom: var(--space-1);
}

.category-bar {
  display: inline-flex;
  gap: var(--space-2);
  padding: var(--space-2) var(--space-4);
}

.category-chip {
  flex-shrink: 0;
}

/* 服务列表 */
.service-list {
  padding: var(--space-2) var(--space-4) var(--space-4);
}

.service-item {
  padding: var(--space-4) 0;
}

.service-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-2);
}

.service-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--md-on-surface);
}

.service-distance {
  font-size: 24rpx;
  color: var(--md-primary);
  font-weight: 500;
}

.service-tags {
  display: flex;
  gap: var(--space-2);
  margin-bottom: var(--space-3);
  flex-wrap: wrap;
}

.service-tag {
  font-size: 22rpx;
}

.service-info {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.service-info-row {
  display: flex;
}

.service-info-label {
  width: 120rpx;
  font-size: 24rpx;
  color: var(--md-on-surface-variant);
  flex-shrink: 0;
}

.service-info-value {
  flex: 1;
  font-size: 26rpx;
  color: var(--md-on-surface-variant);
}

.service-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: var(--space-3);
}

/* Pill 按钮 */
.btn-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 48rpx;
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

.btn-pill--primary {
  background: var(--md-primary);
  color: var(--md-on-primary);
}

.btn-pill--primary:active {
  background: linear-gradient(rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.12)), var(--md-primary);
}

.btn-pill--small {
  height: 64rpx;
  padding: 0 32rpx;
  font-size: 24rpx;
}
