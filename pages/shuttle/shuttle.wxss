/* 班车信息页样式 */

.shuttle-section {
  margin: var(--space-4) var(--space-4) var(--space-6);
}

.route-header {
  padding: var(--space-5) var(--space-4);
  text-align: center;
}

.route-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--md-on-surface);
  display: block;
  margin-bottom: var(--space-3);
}

.route-chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: var(--space-2);
}

/* 时刻表 */
.schedule-list {
  background: var(--md-surface);
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.schedule-item {
  display: flex;
  align-items: center;
  padding: var(--space-3) var(--space-4);
  position: relative;
}

.schedule-item::after {
  content: '';
  position: absolute;
  left: var(--space-4);
  right: var(--space-4);
  bottom: 0;
  height: 1rpx;
  background: var(--md-outline-variant);
  transform: scaleY(0.5);
}

.schedule-item:last-child::after {
  display: none;
}

.schedule-time-marker {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--space-3);
}

.schedule-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.schedule-dot--upcoming {
  background: var(--md-primary);
}

.schedule-dot--soon {
  background: var(--md-tertiary);
  border: 4rpx solid var(--md-primary-container);
}

.schedule-dot--passed {
  background: var(--md-surface-variant);
}

.schedule-time-content {
  display: flex;
  flex-direction: column;
}

.schedule-time-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--md-primary);
}

.schedule-time-status {
  font-size: 20rpx;
  color: var(--md-on-surface-variant);
  margin-top: 4rpx;
}

.schedule-item.passed .schedule-time-text {
  color: var(--md-on-surface-variant);
  text-decoration: line-through;
}

/* 站点 */
.stops-list {
  padding: var(--space-3) var(--space-4);
}

.stop-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  position: relative;
}

.stop-marker {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: var(--space-3);
}

.stop-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--md-outline-variant);
  flex-shrink: 0;
}

.stop-dot--start {
  background: var(--md-primary);
}

.stop-dot--end {
  background: var(--md-outline);
}

.stop-line {
  width: 2rpx;
  height: 40rpx;
  background: var(--md-outline-variant);
}

.stop-name {
  font-size: 30rpx;
  color: var(--md-on-surface-variant);
  font-weight: 500;
}

/* 联系 */
.contact-row {
  padding: var(--space-3) var(--space-4);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.contact-info {
  display: flex;
  flex-direction: column;
}

.contact-label {
  font-size: 24rpx;
  color: var(--md-on-surface-variant);
  margin-bottom: 4rpx;
}

.contact-phone {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--md-primary);
}

.contact-action {
  padding: 12rpx 28rpx;
  border-radius: var(--radius-xs);
  background: var(--md-primary);
}

.contact-action-text {
  font-size: 26rpx;
  color: var(--md-on-primary);
  font-weight: 500;
}
