/* 班车信息页样式 */

.shuttle-section {
  margin: 0 32rpx 48rpx;
}

.route-header {
  padding: 48rpx 32rpx;
  text-align: center;
}

.route-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--md-on-surface);
  display: block;
  margin-bottom: 24rpx;
  letter-spacing: -0.4rpx;
}

.route-chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
}

/* 时刻表 */
.time-list {
  padding: 16rpx 0;
}

.time-item {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  position: relative;
}

.time-item::after {
  content: '';
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 0;
  height: 1rpx;
  background: var(--md-outline-variant);
  transform: scaleY(0.5);
}

.time-item:last-child::after {
  display: none;
}

.time-marker {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.time-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.time-dot--upcoming {
  background: var(--md-primary);
}

.time-dot--soon {
  background: var(--md-tertiary);
  border: 4rpx solid var(--md-primary-container);
  box-sizing: border-box;
}

.time-dot--passed {
  background: var(--md-surface-variant);
}

.time-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.time-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--md-primary);
}

.time-item.passed .time-text {
  color: var(--md-on-surface-variant);
  text-decoration: line-through;
}

.time-status {
  font-size: 22rpx;
  color: var(--md-on-surface-variant);
  margin-top: 4rpx;
}

/* 站点 */
.stops-list {
  padding: 24rpx 32rpx;
}

.stop-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  position: relative;
}

.stop-marker {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 24rpx;
  min-height: 48rpx;
}

.stop-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--md-outline-variant);
  flex-shrink: 0;
}

.stop-dot--start {
  background: var(--md-primary);
}

.stop-dot--end {
  background: var(--md-outline);
}

.stop-line {
  width: 2rpx;
  flex: 1;
  min-height: 32rpx;
  background: var(--md-outline-variant);
}

.stop-name {
  font-size: 30rpx;
  color: var(--md-on-surface-variant);
  font-weight: 500;
}

/* 联系 */
.contact-row {
  padding: 24rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.contact-info {
  display: flex;
  flex-direction: column;
}

.contact-label {
  font-size: 24rpx;
  color: var(--md-on-surface-variant);
  margin-bottom: 4rpx;
}

.contact-phone {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--md-primary);
}

.contact-action {
  padding: 16rpx 36rpx;
  border-radius: 9999rpx;
  background: var(--md-primary);
}

.contact-action-text {
  font-size: 26rpx;
  color: var(--md-on-primary);
  font-weight: 500;
}
