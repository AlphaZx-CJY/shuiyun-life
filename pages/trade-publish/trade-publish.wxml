<md-app-bar title="发布闲置" showBack="{{true}}" />

<view class="page-container">
  <view class="form-body">
    <!-- 商品图片 -->
    <view class="form-item">
      <text class="form-label">商品图片 <text class="form-optional">（最多3张）</text></text>
      <view class="image-upload-row">
        <view class="image-thumb-wrap" wx:for="{{images}}" wx:key="*this">
          <image class="image-thumb" src="{{item}}" mode="aspectFill" bindtap="onPreviewImage" data-index="{{index}}" />
          <view class="image-remove" data-index="{{index}}" bindtap="onRemoveImage">
            <text class="image-remove-icon">×</text>
          </view>
        </view>
        <view wx:if="{{images.length < 3}}" class="image-upload-btn" bindtap="onChooseImage">
          <text class="image-upload-plus">+</text>
        </view>
      </view>
    </view>

    <!-- 商品标题 -->
    <view class="form-item">
      <md-text-field
        label="商品标题 *"
        placeholder="例如：宜家双人沙发，9成新"
        value="{{form.title}}"
        data-field="title"
        maxlength="50"
        bind:input="onInputChange"
      />
    </view>

    <!-- 分类 -->
    <view class="form-item">
      <text class="form-label">分类</text>
      <picker mode="selector" range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="form-picker">
          <text class="form-picker-text">{{categories[categoryIndex].name}}</text>
          <view class="form-picker-arrow"></view>
        </view>
      </picker>
    </view>

    <!-- 售价 -->
    <view class="form-item">
      <text class="form-label">售价 <text class="form-required">*</text></text>
      <view class="form-price-row">
        <text class="form-price-symbol">¥</text>
        <view class="form-price-field">
          <md-text-field
            placeholder="0.00"
            type="digit"
            value="{{form.price}}"
            data-field="price"
            bind:input="onInputChange"
          />
        </view>
      </view>
    </view>

    <!-- 原价 -->
    <view class="form-item">
      <text class="form-label">原价</text>
      <view class="form-price-row">
        <text class="form-price-symbol">¥</text>
        <view class="form-price-field">
          <md-text-field
            placeholder="0.00"
            type="digit"
            value="{{form.originalPrice}}"
            data-field="originalPrice"
            bind:input="onInputChange"
          />
        </view>
      </view>
    </view>

    <!-- 描述 -->
    <view class="form-item">
      <md-text-field
        label="商品描述"
        placeholder="描述一下商品的使用情况、品牌、尺寸等信息..."
        value="{{form.description}}"
        data-field="description"
        maxlength="500"
        multiline
        bind:input="onInputChange"
      />
    </view>

    <!-- 联系人 -->
    <view class="form-item">
      <md-text-field
        label="联系人 *"
        placeholder="例如：3号楼王先生"
        value="{{form.seller}}"
        data-field="seller"
        bind:input="onInputChange"
      />
    </view>

    <!-- 联系电话 -->
    <view class="form-item">
      <md-text-field
        label="联系电话 *"
        placeholder="请输入手机号"
        type="number"
        value="{{form.phone}}"
        data-field="phone"
        maxlength="11"
        bind:input="onInputChange"
      />
    </view>

    <!-- 位置 -->
    <view class="form-item">
      <md-text-field
        label="位置"
        placeholder="例如：3号楼1202室"
        value="{{form.location}}"
        data-field="location"
        bind:input="onInputChange"
      />
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="form-actions">
    <view class="form-btn form-btn--secondary" bindtap="onCancel">
      <text>取消</text>
    </view>
    <view class="form-btn form-btn--primary" bindtap="onSubmit">
      <text>发布</text>
    </view>
  </view>
</view>
