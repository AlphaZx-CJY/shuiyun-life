/* 复用 trade 页瀑布流样式 */ .page-container { padding-top: 20rpx; } .trade-waterfall { display: flex; gap: 20rpx;
padding: 0 40rpx; } .trade-column { flex: 1; display: flex; flex-direction: column; gap: 20rpx; } .trade-card {
background: var(--md-surface); border-radius: 20rpx; overflow: hidden; transition: transform 100ms ease-out; }
.trade-card:active { transform: scale(0.98); } .trade-color-area { width: 100%; height: 240rpx; display: flex;
align-items: center; justify-content: center; position: relative; overflow: hidden; } .trade-color-area::after {
content: ''; position: absolute; right: -40rpx; bottom: -40rpx; width: 140rpx; height: 140rpx; border-radius: 50%;
background: rgba(255, 255, 255, 0.2); } .trade-color-area md-icon { position: relative; z-index: 1; }
.trade-color--primary { background: var(--md-primary-container); } .trade-color--primary md-icon { color:
var(--md-on-primary-container); } .trade-color--secondary { background: var(--md-secondary-container); }
.trade-color--secondary md-icon { color: var(--md-on-secondary-container); } .trade-color--tertiary { background:
var(--md-tertiary-container); } .trade-color--tertiary md-icon { color: var(--md-on-tertiary-container); }
.trade-color--baby { background: var(--md-voice-container); } .trade-color--baby md-icon { color:
var(--md-voice-on-container); } .trade-color--other { background: var(--md-payment-container); } .trade-color--other
md-icon { color: var(--md-payment-on-container); } .trade-info { padding: 20rpx 24rpx; } .trade-title { font-size:
28rpx; font-weight: 600; color: var(--md-on-surface); margin-bottom: 12rpx; line-height: 1.4; overflow: hidden;
text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; } .trade-price-row {
display: flex; align-items: baseline; gap: 12rpx; margin-bottom: 8rpx; } .trade-price { font-size: 32rpx; font-weight:
800; color: var(--md-primary); } .trade-original { font-size: 24rpx; color: var(--md-on-surface-variant);
text-decoration: line-through; } .trade-meta-row { display: flex; justify-content: space-between; align-items: center; }
.trade-seller { font-size: 22rpx; color: var(--md-on-surface-variant); } .trade-discount { font-size: 20rpx;
font-weight: 500; padding: 4rpx 12rpx; border-radius: 8rpx; background: var(--md-tag-bg); color: var(--md-tag-text); }
.trade-category { font-size: 20rpx; font-weight: 500; padding: 4rpx 12rpx; border-radius: 8rpx; background:
var(--md-primary-container); color: var(--md-on-primary-container); align-self: flex-start; margin-bottom: 8rpx; }
.trade-card-image { width: 100%; height: 240rpx; display: block; border-radius: 20rpx 20rpx 0 0; background:
var(--md-surface-container); } /* 骨架图 */ @keyframes skeleton-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.55; }
} .skeleton-card { background: var(--md-surface); } .skeleton-card .skeleton-image { width: 100%; height: 240rpx;
background: var(--md-surface-container); animation: skeleton-pulse 1.6s ease-in-out infinite; border-radius: 20rpx 20rpx
0 0; } .skeleton-card .skeleton-info { padding: 20rpx 24rpx; display: flex; flex-direction: column; gap: 16rpx; }
.skeleton-line { height: 32rpx; border-radius: 8rpx; background: var(--md-surface-container); animation: skeleton-pulse
1.6s ease-in-out infinite; } .skeleton-line--short { width: 40%; } .skeleton-line--medium { width: 60%; } /* 帮助提示 */
.help-tip { margin: 32rpx 40rpx 0; padding: 24rpx; background: var(--md-surface-container); border-radius: 16rpx; }
.help-tip-text { font-size: 24rpx; color: var(--md-on-surface-variant); line-height: 1.5; display: block; }
