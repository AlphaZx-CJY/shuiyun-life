<view class="page-container">
  <!-- 彩色 Hero — 包含标题信息 -->
  <view class="detail-hero detail-hero--{{config.color}}">
    <view class="detail-hero-decor detail-hero-decor--1"></view>
    <view class="detail-hero-decor detail-hero-decor--2"></view>
    <view class="detail-hero-icon">
      <md-icon
        wx:if="{{type === 'news'}}"
        name="/images/icons/material/article-on.svg"
        size="64"
        color="rgba(255,255,255,0.35)"
      />
      <md-icon
        wx:elif="{{type === 'schedule'}}"
        name="/images/icons/material/event-on.svg"
        size="64"
        color="rgba(255,255,255,0.35)"
      />
      <md-icon
        wx:elif="{{type === 'payment'}}"
        name="/images/icons/material/receipt_long-on.svg"
        size="64"
        color="rgba(255,255,255,0.35)"
      />
      <md-icon
        wx:elif="{{type === 'guide'}}"
        name="/images/icons/material/menu_book-on.svg"
        size="64"
        color="rgba(255,255,255,0.35)"
      />
      <md-icon
        wx:elif="{{type === 'service'}}"
        name="/images/icons/material/storefront-on.svg"
        size="64"
        color="rgba(255,255,255,0.35)"
      />
      <md-icon
        wx:elif="{{type === 'voice'}}"
        name="/images/icons/material/article-on.svg"
        size="64"
        color="rgba(255,255,255,0.35)"
      />
    </view>
    <view class="detail-hero-content">
      <block wx:if="{{loading}}">
        <view class="skeleton-hero-block skeleton-hero-block--tag"></view>
        <view class="skeleton-hero-block skeleton-hero-block--title"></view>
        <view class="skeleton-hero-block skeleton-hero-block--meta"></view>
      </block>
      <block wx:else>
        <text class="detail-hero-tag">{{tag}}</text>
        <text class="detail-hero-title">{{title}}</text>
        <text class="detail-hero-meta">{{meta}}</text>
      </block>
    </view>
  </view>

  <!-- 正文 -->
  <view class="detail-content">
    <block wx:if="{{loading}}">
      <view class="skeleton-line skeleton-line--full" wx:for="{{[1,2,3,4,5]}}" wx:key="*this"></view>
    </block>
    <block wx:else>
      <rich-text wx:if="{{content}}" nodes="{{content}}" />

      <!-- 图片展示 -->
      <view wx:if="{{images.length > 0}}" class="detail-images">
        <image
          wx:for="{{images}}"
          wx:key="*this"
          class="detail-image"
          src="{{item}}"
          mode="aspectFill"
          bindtap="onPreviewImage"
          data-index="{{index}}"
        />
      </view>

      <view wx:if="{{!content && images.length === 0}}" class="detail-empty">
        <text>暂无内容</text>
      </view>
    </block>
  </view>
</view>
