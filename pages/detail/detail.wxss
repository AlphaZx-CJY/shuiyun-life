/* 通用详情页 — 彩色容器风格 */ /* Hero 区域 */ .detail-hero { width: 100%; height: 440rpx; display: flex; align-items:
center; justify-content: center; position: relative; overflow: hidden; } /* 装饰圆 */ .detail-hero-decor { position:
absolute; border-radius: 50%; opacity: 0.2; } .detail-hero-decor--1 { right: -120rpx; top: -80rpx; width: 360rpx;
height: 360rpx; background: var(--md-secondary-container); } .detail-hero-decor--2 { left: -80rpx; bottom: -120rpx;
width: 280rpx; height: 280rpx; background: var(--md-tertiary-container); } /* 颜色映射 */ .detail-hero--primary {
background: var(--md-primary); } .detail-hero--secondary { background: var(--md-secondary); } .detail-hero--tertiary {
background: var(--md-tertiary); } .detail-hero--payment { background: var(--md-payment-on-container); } /* 标题区 */
.detail-header { padding: 48rpx 40rpx; background: var(--md-surface); } .detail-tag { display: inline-block; background:
var(--md-tag-bg); color: var(--md-tag-text); font-size: 22rpx; font-weight: 500; padding: 6rpx 20rpx; border-radius:
16rpx; margin-bottom: 20rpx; } .detail-title { font-size: 48rpx; font-weight: 800; color: var(--md-on-surface);
line-height: 1.2; margin-bottom: 16rpx; letter-spacing: -0.6rpx; display: block; } .detail-meta { font-size: 26rpx;
color: var(--md-on-surface-variant); } /* 正文 */ .detail-content { padding: 0 40rpx 80rpx; background:
var(--md-surface); } .detail-content rich-text { font-size: 30rpx; color: var(--md-on-surface); line-height: 1.85; }
.detail-empty { padding: 80rpx 0; text-align: center; font-size: 28rpx; color: var(--md-on-surface-variant); }
