.md-field { display: flex; flex-direction: column; gap: 12rpx; } .md-field__label { font-size: 28rpx; font-weight: 500;
color: var(--md-on-surface); } .md-field__input-wrap { background: var(--md-surface-container-low); border: 1rpx solid
var(--md-outline-variant); border-radius: 16rpx; padding: 0 24rpx; transition: border-color 150ms ease-out; }
.md-field__input-wrap:focus-within { border-color: var(--md-primary); } .md-field--error .md-field__input-wrap {
border-color: var(--md-error); } .md-field__input { width: 100%; height: 96rpx; font-size: 30rpx; color:
var(--md-on-surface); line-height: 1.5; background: transparent; } .md-field__input--multiline { height: 200rpx;
padding: 24rpx 0; } .md-field__error { font-size: 24rpx; color: var(--md-error); }
