.tab-bar { position: fixed; bottom: 0; left: 0; right: 0; height: calc(120rpx + env(safe-area-inset-bottom));
background: var(--md-surface-container); display: flex; flex-direction: row; justify-content: space-around; align-items:
center; border-top: 2rpx solid var(--md-outline); box-sizing: border-box; } .tab-bar-item { flex: 1; display: flex;
flex-direction: column; align-items: center; justify-content: center; height: 120rpx; } .tab-bar-indicator { position:
relative; width: 128rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; border-radius:
40rpx; transition: background-color 0.15s ease; } .tab-bar-item.active .tab-bar-indicator { background:
var(--md-secondary-container); } .tab-bar-icon { position: absolute; width: 48rpx; height: 48rpx; transition: opacity
0.15s ease; } .tab-bar-icon--off { opacity: 1; } .tab-bar-icon--on { opacity: 0; } .tab-bar-item.active
.tab-bar-icon--off { opacity: 0; } .tab-bar-item.active .tab-bar-icon--on { opacity: 1; } .tab-bar-text { font-size:
22rpx; font-weight: 500; margin-top: 4rpx; line-height: 1.2; } .tab-bar-item.active .tab-bar-text { color:
var(--md-on-secondary-container); } .tab-bar-item:not(.active) .tab-bar-text { color: var(--md-on-surface-variant); }
