/* MD3 Expressive Card 样式 */ /* 必须配合 app.wxss 中的 CSS 变量使用 */ .md-card { background-color: var(--md-surface);
border-radius: 20rpx; overflow: hidden; } .md-card__media { width: 100%; height: 320rpx; border-radius: 20rpx 20rpx 0 0;
overflow: hidden; } .md-card__media image { width: 100%; height: 100%; } .md-card__content { padding: 24rpx; }
.md-card__title { font-size: 36rpx; font-weight: 600; line-height: 1.3; color: var(--md-on-surface); letter-spacing:
-0.4rpx; } .md-card__subtitle { display: block; margin-top: 8rpx; font-size: 24rpx; font-weight: 500; line-height: 1.4;
color: var(--md-on-surface-variant); } .md-card__body { margin-top: 16rpx; font-size: 32rpx; line-height: 1.75; color:
var(--md-on-surface); } .md-card__actions { display: flex; padding: 16rpx 24rpx 24rpx; gap: 16rpx; }
